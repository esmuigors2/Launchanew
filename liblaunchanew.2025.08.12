helpings(){
    echo; echo "Script is intended to restart failed jobs and launch additional utilities. Every failure is reported to stdout and to $HOME/CalcLog.logg.$HOSTNAME file. Failed job inputs are copied to file /path/to/inputfile_failed.gjf. At the end all .out and .fchk files are compressed to /path/to/inputfile.tgz and to /path/to/inputfile_fchks.tgz, respectively. If the output file contains no 'Normal termination' lines, by default IT WILL BE DELETED after launchanew finishes; this can be overridden by specifying -u option."; echo
    echo "And congratulations are printed."
    echo "If the name of input file is not specified, that of input file is used, replacing '.gjf' with '.out'."; echo
    echo "ATTENTION! New defaults starting from version 5.8.6.0."; echo
    echo -e "\e[38;5;40m-t\e[0m or \e[38;5;40m--takeover\e[0m:\tscript will try to take over the Gaussian calculation currently run on the machine; You need not to kill the old launchanew process (but may do so) and You MUST NOT redirect the input of this script to any logg file -- it will append to the old one, with takeover time recorded. The input file argument is also ignored."
    echo
    echo "Whether to delete scratch files in $GAUSS_SCRDIR directory or not to do that:"
    echo -e "   \e[38;5;40mno option\e[0m\tdo this once before start and also after every misrun of Gaussian"
    echo -e "   \e[38;5;40m-r\e[0m or \e[38;5;40m--remove\e[0m:\tdo NOT do this once in the beginning"
    echo -e "   \e[38;5;40m-a\e[0m or \e[38;5;40m--noalltimeneat\e[0m:\tSUPPRESS DOING SO after every misrun of Gaussian."
    echo; echo "Behaviour regarding jobs using checkpoint files that were modified by failed jobs:"
    echo -e "   \e[38;5;40mno option\e[0m:\tall jobs until the end of compound job will be omitted. A compound job contains multiple steps which are neede to obtain complete results."
    echo -e "   \e[38;5;40m-c\e[0m or  \e[38;5;40m--ccheck\e[0m:\tjob using chk from job just failed will be omitted"
    echo -e "   \e[38;5;40m-d\e[0m or \e[38;5;40m--nodscheck\e[0m:\tscript will NOT remove even steps remaining in the failed multistep job that used the .CHK"
    echo -e "   \e[38;5;40m-o\e[0m or \e[38;5;40m--useoldchk\e[0m:\tcontinue from the previous CHK file without foolproofing. By default, launchanew will abort if any of .chk files mentioned in the input are found in the present directory."
    echo
    echo -e "\e[38;5;40m-s\e[0m or \e[38;5;40m--gofiner\e[0m:\tscript WILL try to solve numeric integration problems by adopting finer grid (might result in problems when comparing with other results!)."
    echo -e "\e[38;5;40m-s\e[0m or \e[38;5;40m--notrysolve\e[0m:\tscript will NOT try to solve SCF convergence or integration, or Opt, or Polar problems, e.g., switch off FMM when neccessary."
    echo -e "\nIf the previous option is NOT set, the following two options are also considered:"
    echo -e "   \e[38;5;40m-b\e[0m or \e[38;5;40m--banginghead\e[0m:\tscript will also try to solve SCF convergence problems with solutions that might not be working at all (if You are desperate)."
    echo -e "   \e[38;5;40m-g\e[0m or \e[38;5;40m--shsaddle\e[0m:\tscript will NOT try to solve the problem of reaching a saddle point instead of minimum in a geometry optimization, which it usuallu does by shifting the geometry along the normal modes with negative force constants."
    echo
    echo -e "\e[38;5;40m-i\e[0m or \e[38;5;40m--changedir\e[0m:\tsubstitute all paths in the input file for the current directory."
    echo -e "\e[38;5;40m-x\e[0m or \e[38;5;40m--nomaxdisk\e[0m:\tremove the MaxDisk keyword from the Route line (it allows to use all the space in the last scratch directory without the size limit or -1)."
    echo -e "\e[38;5;40m-w\e[0m or \e[38;5;40m--norwfmod\e[0m:\tdo not modify the size or RWF files according to available disk on the node (You may have done it before using different parameters for determination of optimal RWF size)"
    echo -e "\e[38;5;40m-l \"node1,node2,node3,…\"\e[0m or \e[38;5;40m--addlinda \"node1,node2,node3,…\"\e[0m:\tadd or modify %LindaWorkers directive in the GJF file"
    echo -e "\e[38;5;40m-p N\e[0m or \e[38;5;40m--noprocmod=N\e[0m:\tuse only N CPU cores for this job; if N=0, do not modify the available memory and number of CPU cores at all (You may have done it before using different parameters for determination of optimal memory size)"
    echo -e "    If You require specific modification of these directives, please call \e[38;5;40mproc2gjf -h\e[0m"
    echo -e "\e[38;5;40m-z\e[0m or \e[38;5;40m--okzero\e[0m:\tdo NOT remove after the calculation all those files title section of which starts with '::: 0000_000 0000_000'; these files were used to generate .FCHK with relevant data (NO, NTO, etc.)"
    echo -e "\e[38;5;40m-u\e[0m or \e[38;5;40m--nostupid\e[0m:\tdelete the output file if it contains no 'Normal termination's or a functional lacked abilities for a compound job"
    echo -e "\e[38;5;40m-y\e[0m or \e[38;5;40m--neverstop\e[0m:\tdo not stop batch execution if there are many consequtive errors (e.g., for manual PES scans from autogenerated geoms a priori including overlapping-atom ones)"
    echo -e "\e[38;5;40m-I ARG\e[0m or \e[38;5;40m--nintersperse=ARG\e[0m:\tto revent longish filenames when erroring, the file is autosplit by a dummy lutil command when distance between lutil lines is more than ARG jobs"
    echo -e "\e[38;5;40m-f\e[0m or \e[38;5;40m--preservechk\e[0m:\tsuppress deletion of the checkpoint files; by default, they are deleted, if You want to look at orbitals, etc., use formchk or cp in the lutil section."
    echo -e "\e[38;5;40m-k\e[0m or \e[38;5;40m--nodalek\e[0m:\tallows to make job immune to the dalek (a script that is run constantly and every 60 minutes checks for hung-up script over the whole cluster)."
    echo -e "\e[38;5;40m-m\e[0m or \e[38;5;40m--monram\e[0m:\trequest monitoring RAM usage every 5 minutes, with writing to file $HOME/MemLog.$(uname -n).logg and $HOME/DiskLog.$(uname -n)"
    echo -e "\e[38;5;40m-Z\e[0m or \e[38;5;40m--notar\e[0m:\tdo not archive the output file (useful for external scripts)"
    echo -e "\e[38;5;40m-v\e[0m or \e[38;5;40m--debugging\e[0m:\tdisplay additional debugging information"
    echo -e "\e[38;5;40m-q\e[0m or \e[38;5;40m--requirements\e[0m:\tdisplay requirements for this script"
    echo -e "\e[38;5;40m-h\e[0m or \e[38;5;40m--help\e[0m:\tdisplay this help."
    echo ; echo -e "Options CAN be specified in bulk (e. g., \e[2mlaunchanew -crom input.file\e[0m)."
}

monitlog() {
    for ioio in $(seq 4); do cp "$1" "$2"; sleep 15; done
    for ioio in $(seq 10); do cp "$1" "$2"; sleep 60; done
    while true; do cp "$1" "$2"; sleep 300; done
}

countato() {
    ramfl=$(cat "$1")
    nra=$(echo "$ramfl" | sed -n '1,/--Link1--/Ip' | tac | sed '1,/^ *[A-Za-z][a-z]\{0,1\}\([-]\{1,2\}[[:alnum:].]\+\)*\(([[:alnum:]=,.]\+)\)*\([ ,\t]\+[-]*[0-9]\+\.[0-9]\+\)\{3\}[ \t]*$/d;/^#/,$d' | wc -l)
    [ -z "$nra" ] && nra=0
    [ $nra -gt 4 ] && nra=$((nra-4)) || nra=0
    while [ -n "$ramfl" ]; do
        ramfl=$(echo "$ramfl" | sed -n '1,/--Link1--/Id')
        nra2=$(echo "$ramfl" | sed -n '1,/--Link1--/Ip'| tac | sed '1,/^ *[A-Za-z][a-z]\{0,1\}\([-]\{1,2\}[[:alnum:].]\+\)*\(([[:alnum:]=,.]\+)\)*\([ ,\t]\+[-]*[0-9]\+\.[0-9]\+\)\{3\}[ \t]*$/d;/^#/,$d' | wc -l)
        [ -z "$nra2" ] && nra2=0
        [ $nra2 -gt 4 ] && nra2=$((nra2-4)) || nra2=0
        [ $nra2 -gt $nra ] && nra=$nra2
    done
    echo $nra
}

getridofdirt(){ # 75 lines long....
    if [ -n "$(ps aux | grep "$(echo $GAUSS_EXEDIR | gawk 'BEGIN{FS=":"} {print $NF}')"i | grep -v grep )" ]; then
        echo "WARNING! Another Gaussian instance is in operation on this node. We will therefore NOT delete any scratch files (whose they would be, eh?)."
        return 1
    fi
    if ($debugging); then
        echo "Using the following directories:"
        echo ""
    fi
    [ -d "${GAUSS_SCRDIR}" ] && [ -n "$(find "${GAUSS_SCRDIR}" -type d -name 'savehaven*')" ] && rmdir ${GAUSS_SCRDIR}/savehaven*$HOSTNAME
    [ -d "${GAUSS_SPRSCRDIR}" ] && [ -n "$(find "${GAUSS_SPRSCRDIR}" -type d -name 'savehaven*')" ] && rmdir ${GAUSS_SPRSCRDIR}/savehaven*$HOSTNAME
    [ -d "${GAUSS_SPRSCRDIR2}" ] && [ -n "$(find "${GAUSS_SPRSCRDIR2}" -type d -name 'savehaven*')" ] && rmdir ${GAUSS_SPRSCRDIR2}/savehaven*$HOSTNAME
    tobesaved=$(monitorchk "$1" 'inf')
    echo "The following checkpoints will not be deleted (seem needed): $tobesaved" # this is because one could possibly need them after the jobs have finished or failed, even if formchk was launched on them
    echo "Among them, actually present are:"
    presentchkoutput=$(ls $tobesaved || echo "  (none)") # does not work with quotation marks (becomes a single argument)
    echo "$presentchkoutput" # | sed '$d' ?? why was this here?
    echo "All checkpoints present:"
    ls *.chk
    echo "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    if [ -n "$tobesaved" ]; then
        mkdir "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"
        [ -d "${GAUSS_SPRSCRDIR}" ] && mkdir "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"
        [ -d "${GAUSS_SPRSCRDIR2}" ] && mkdir "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME"
        for kld in $tobesaved; do
            [ -n "$(echo "$kld" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -f "$kld" ] && mv "$kld" "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME/"
            [ -n "$(echo "$kld" | grep "${GAUSS_SCRDIR}/")" ] && [ -f "$kld" ] && mv "$kld" "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME/"
            [ -n "$(echo "$kld" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -f "$kld" ] && mv "$kld" "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME/"
            [ -n "$(echo "$kld" | grep "${GAUSS_LNCHDIR}/")" ] && [ -f "$kld" ] && mv "$kld" "${GAUSS_LNCHDIR}/savehaven.${mygorgeouspid}.$HOSTNAME/"
            [ -f "$kld" ] && echo "Where is this interesting checkpoint located? Moving it to ${GAUSS_LNCHDIR} ." && mv "$kld" "${GAUSS_LNCHDIR}/savehaven.${mygorgeouspid}.$HOSTNAME/"
        done
    fi
    for aa in  $GAUSS_SCRDIR/*; do # thanks to Costi Ciudatu @ stackoverflow.com, question 6363441 (how to check if files exist using pattern matching)
        [ -e "$aa" ] && (echo "carefullness..."; rm $GAUSS_SCRDIR/*.chk $GAUSS_SCRDIR/*int $GAUSS_SCRDIR/*d2e $GAUSS_SCRDIR/*rwf $GAUSS_SCRDIR/*inp $GAUSS_SCRDIR/*skr 2>&1 | grep -v 'No such file or directory'; echo "Removed all the old scratch files in $GAUSS_SCRDIR.") || echo "No old scratch files found in $GAUSS_SCRDIR!"
        break
    done
    if [ -d "$GAUSS_SPRSCRDIR" ]; then
        for aa in  $GAUSS_SPRSCRDIR/*; do # thanks to Costi Ciudatu @ stackoverflow.com, question 6363441 (how to check if files exist using pattern matching)
            [ -e "$aa" ] && (echo "carefullness..."; rm $GAUSS_SPRSCRDIR/*.chk $GAUSS_SPRSCRDIR/*int $GAUSS_SPRSCRDIR/*d2e $GAUSS_SPRSCRDIR/*rwf $GAUSS_SPRSCRDIR/*inp $GAUSS_SPRSCRDIR/*skr 2>&1 | grep -v 'No such file or directory'; echo "Removed all the old scratch files in $GAUSS_SPRSCRDIR.") || echo "No old scratch files found in $GAUSS_SPRSCRDIR!"
            break
        done
    fi
    if [ -d "$GAUSS_SPRSCRDIR2" ]; then
        for aa in  $GAUSS_SPRSCRDIR2/*; do # thanks to Costi Ciudatu @ stackoverflow.com, question 6363441 (how to check if files exist using pattern matching)
            [ -e "$aa" ] && (echo "carefullness..."; rm $GAUSS_SPRSCRDIR2/*.chk $GAUSS_SPRSCRDIR2/*int $GAUSS_SPRSCRDIR2/*d2e $GAUSS_SPRSCRDIR2/*rwf $GAUSS_SPRSCRDIR/*inp $GAUSS_SPRSCRDIR2/*skr 2>&1 | grep -v 'No such file or directory'; echo "Removed all the old scratch files in $GAUSS_SPRSCRDIR2.") || echo "No old scratch files found in $GAUSS_SPRSCRDIR2!"
            break
        done
    fi
    if [ -d "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME" ]; then
        if [ -n "$(ls "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME")" ]; then
            ($debugging) && echo "DEBUG: ${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME directory is found"
            for kld in "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"/*; do
                for rty in $tobesaved; do
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && mv "$kld" "$rty"
                done
                [ -f "$kld" ] && mv "$kld" "${GAUSS_LNCHDIR}/"
            done
        fi
        rmdir "${GAUSS_SCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"
    fi
    if [ -d "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME" ]; then
        if [ -n "$(ls "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME")" ]; then
            ($debugging) && echo "DEBUG: ${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME directory is found"
            for kld in "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"/*; do
                for rty in $tobesaved; do
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && mv "$kld" "$rty"
                done
                [ -f "$kld" ] && mv "$kld" "${GAUSS_SPRSCRDIR}/"
            done
        fi
        rmdir "${GAUSS_SPRSCRDIR}/savehaven.${mygorgeouspid}.$HOSTNAME"
    fi
    if [ -d "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME" ]; then
        if [ -n "$(ls "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME")" ]; then
            ($debugging) && echo "DEBUG: ${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME directory is found"
            for kld in "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME"/*; do
                for rty in $tobesaved; do
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && mv "$kld" "$rty"
                    [ "$(basename "$kld")" == "$(basename "$rty")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SCRDIR}/")" ] && [ -z "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR2}/")" ] && [ -n "$(echo "$rty" | grep "${GAUSS_SPRSCRDIR}/")" ] && mv "$kld" "$rty"
                done
                [ -f "$kld" ] && mv "$kld" "${GAUSS_SPRSCRDIR2}/"
            done
        fi
        rmdir "${GAUSS_SPRSCRDIR2}/savehaven.${mygorgeouspid}.$HOSTNAME"
    fi
    echo " Beware! $GAUSS_LNCHDIR can also contain some scratch files causing computational miscarriage."
    if [ -n "$1" ]; then
        homerubbish=($(egrep -o -e "$GAUSS_LNCHDIR"'[^,]*\.rwf' -e "$GAUSS_LNCHDIR"'[^,]*\.int' -e "$GAUSS_LNCHDIR"'[^,]*\.d2e' $1 | sort -u))
        for unca in ${homerubbish[@]}; do
            [ -f "$unca" ] && rm "$unca" && echo "Deleted $unca ..."
        done
        homerubbish=($(egrep -o -e "$GAUSS_LNCHDIR"'[^,]*\.chk' $1 | sort -u))
        for unca in ${homerubbish[@]}; do
            [ -f "$unca" ] && [ -z "$(echo "carefullness..."; echo "$tobesaved" | grep "$unca")" ] && rm "$unca" && echo "Deleted $unca ..."
        done
        echo "Now scratch files in $GAUSS_LNCHDIR should have been removed!"
    else
        echo "As per defects in the code, they will not be removed..."
    fi
    echo "To be sure, here is the list of checkpoints that were to be saved:"
    presentchkoutput=$(ls $tobesaved 2>/dev/null || echo "  (none)") # does not work with quotation marks (becomes a single argument)
    [ "$(echo "$presentchkoutput" | wc -l)" -gt 1 ] && echo "$presentchkoutput" | sed '$d'
}

diskspace() {
        echo -e "\nDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD\n"
    echo "Environment variable values:"; echo "GAUSS_LNCHDIR : $GAUSS_LNCHDIR"; echo "GAUSS_SCRDIR : $GAUSS_SCRDIR"; echo "GAUSS_SPRSCRDIR : $GAUSS_SPRSCRDIR"; echo "GAUSS_SPRSCRDIR2 : $GAUSS_SPRSCRDIR2"
    echo "Used disk space is:"; du -hs $GAUSS_SPRSCRDIR $GAUSS_SCRDIR $GAUSS_LNCHDIR; echo "..."; [ -d "$GAUSS_SPRSCRDIR" ] && du -hs $GAUSS_SPRSCRDIR/*; echo "..."; [ -d "$GAUSS_SCRDIR" ] && du -hs $GAUSS_SCRDIR/*; echo "..."; [ -d "$GAUSS_SPRSCRDIR2" ] && du -hs $GAUSS_SPRSCRDIR2/*; echo "..."; for jki in $GAUSS_LNCHDIR/*; do [ -d "$jki" ] && du -hs "$jki"; echo "..."; done; echo "Free disk space is:"; df -h $GAUSS_SPRSCRDIR $GAUSS_SCRDIR $GAUSS_LNCHDIR $GAUSS_SPRSCRDIR2 > batutaibn.$HOSTNAME &
        declare df_piddy=$!
        (sleep 7; eval disown $df_piddy; eval kill -n 9 $df_piddy) &
        wait $df_piddy; [ $(wc -c < batutaibn.$HOSTNAME) -gt 0 ] && { echo -e "=====================\nFree disk space is:"; cat batutaibn.$HOSTNAME; }; rm batutaibn.$HOSTNAME
        # for df output
        [ -f "$HOME/DiskLog.$(uname -n)" ] && { echo -e "=====================\nFree disk space was:"; cat $HOME/DiskLog.$(uname -n); }
        echo "====================="
        mauritius=$(grep -i -m 1 "%RWF=" $1)
        [ -n "$mauritius" ] && { mauritius=$(grep -m 3 -i -e "^%RWF=" -e "^%INT=" -e "^%D2E=" "$1" | sort -u | sed 's/.*=//;s/,[0-9]\+[MG][BW]/ /Ig');
        wc -c $mauritius; }
        [ -n "$mauritius" ] && echo -n "In case none of these files are too big, " || echo -n "If the directory is not full, "
        echo "this may be an out-of-memory error."
        echo -e "DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD\n"
        ramsfield
}

ramsfield() {
        echo 'RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR'
        echo "Currently free memory & swap:"; echo $(free -m); echo "====================="
        echo "RAM monitoring output:";
        tail -19 $HOME/MemLog.$(uname -n)
        echo -e "RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR\n"
}

foolproof() { # IS THE CHECKPOINT FOUND IN CURRENT INPUT FILE FOUND ALSO IN THE WORKING DIRECTORY (I. E., LEFT OVER FROM PREVIOUS CALCULATIONS)? THIS CAN RUIN THE PRESENT JOB!
    presentchks=( $(echo "carefullness..."; grep '\.chk' $1 | grep -v 'formchk' | grep -o '[0-9A-Za-z_]*\.chk') )  # -mtime 0
    presentchks=( $(echo ${presentchks[@]} | sed 's/ /\n/g'  | sort | uniq | xargs ) )
    # echo "Currently used .CHK files are:"; echo ${presentchks[@]} # echoes the whole array
    s49ffmm=${#presentchks[@]}
    echo "Using $s49ffmm checkpoints."
    for albuquerke in $(seq 0 $(($s49ffmm-1))); do
        [ -f "${presentchks[$albuquerke]}" ] && { export listchk=${presentchks[$albuquerke]}; return 2; }
    done
    return 0;
}

monitorchk() { # PRINTS OUT CHK FILES FOUND IN THE WORKING DIRECTORY OR JUST IN THE INPUT FILE
    presentchks=( $(grep '\.chk' $1 | grep -v 'formchk' | grep -o '[^ =]*\.chk') )  # -mtime 0
    presentchks=( $(echo ${presentchks[@]} | sed 's/ /\n/g'  | sort -u | xargs ) )
    if [ -n "$2" ] && [ "$2" == "inf" ]; then
        for klh in ${presentchks[@]}; do
            numbernow="$numbernow $klh"
        done
        echo "$numbernow"
    else
        while true; do
            numbernow="$(date) : "
            for klh in ${presentchks[@]}; do
                [ -f "$klh" ] && numbernow="$numbernow $klh"
            done
            echo "$numbernow" >> $HOME/ChkLogg.$HOSTNAME
            [ $tutelka -eq 0 ] && break
            sleep 1800
        done
    fi
}

getfchklist(){ # GETS THE LIST OF FORMCHECK FILES TO BE PRODUCED
    i=0; j=0 
    if [ -n "$(grep 'formchk' $1)" ]; then
        while read a b c d; do [ -n "$d" ] || d="${c//.chk/.fchk}"; i=$((i+1)); presentchks[i]="$d"; [ -f "$d" ] && [ -z "$2" ] && { j=$((j+1)); mv $d ${d%.fchk}_old$i_$(date +%d%m%y_%H%M%S).fchk; }; done <<< "$(grep 'formchk' $1 | sed 's/ -[^ ]*//g')"
        export listchk="$(echo ${presentchks[@]} | tr ' ' '\n' | sort -u | tr '\n' ' ')"
    fi
    echo "Producing $i formcheck files."
    [ $j -gt 0 ] && echo "Renamed $j conflicting FCHK files."
    
    nonpasaran=( $(echo ${presentchks[@]} | tr ' ' '\n' | sort -u | tr '\n' ' ') )
    pasaran=($(echo ${presentchks[@]} | tr -s ''))
    #echo "Unique are ${nonpasaran[@]}"; echo "All are ${pasaran[@]}"
    [ ${#nonpasaran[@]} -eq ${#pasaran[@]} ] && return 0 || { [ -z "$2" ] && echo "Input file itself has $((${#pasaran[@]}-${#nonpasaran[@]})) conflicting formcheck files!" || return 0; return 2; }
}

copyfirst() { # COPIES THE FIRST JOB SO THAT WE CAN RUN SOMETHING LIKE SCF WITH VSHIFT OR SLEAZY AND THEN USE IT AS A GUESS; IN FUTURE, POSSIBLY EXPAND TO SMALLER BASIS SETS
    inputtfi="$1"
    temporamt="/tmp/simalungun.$$.copyfirst"
    tempora2mt="/tmp/phoukaten.$$.copyfirst"
    while [ $(grep -nm 1 '^ *$' "$inputtfi" | cut -d : -f 1) -eq 1 ]; do
        sed -i '1d' "$inputtfi"
    done
    if [ -z "$(sed -n '1,/^ *#/p' "$inputtfi" | grep -i -e '^%Chk=')" ]; then
        afterheaderline=$(grep -nm 1 -e '^ *$' "$inputtfi" | cut -d : -f 1)
        sed -i "$afterheaderline"'s@.*@%Chk='"$(pwd)/${inputtfi%.gjf}.chk\n@" "$inputtfi"
    fi
    sed -n '1,/--Link1--/p' "$inputtfi" > "$temporamt"
    echo >> "$temporamt"
    if [ -z "$(sed -n '1,/^ *#/p' "$inputtfi" | grep -i -e 'Geom[(=]\+[^ ]*Check')" ]; then
        sed -i '1,/#/{s/#[^!]*/& Geom=Check/}' "$inputtfi"
        geombeginline=$(grep -nm 1 -e '^[-+]*[0-9]\+ \+[0-9]\+' "$inputtfi" | cut -d : -f 1)
        geombeginline=$((geombeginline+1))
        geomendline=$(sed -n "$((1+geombeginline))"',$p' "$inputtfi" | grep -nm 1 -e '^ *$' | cut -d : -f 1)
        geomendline=$((geomendline+geombeginline-1))
        sed -i "${geombeginline},${geomendline}d" "$inputtfi"
    fi
    if [ -n "$(sed -n '1,/^ *#/p' "$inputtfi" | grep -i -e 'Guess[(=]\+[^ ]*\(TCheck\|Huckel\|INDO\|AM1\|Core\|Only\|Always\)')" ]; then
        sed -i '1,/#/{s@\(TCheck\|[Old]\+Huckel\|INDO\|AM1\|Core\|Only\|Always\)@Read@}' "$inputtfi"
    fi
    if [ -z "$(sed -n '1,/^ *#/p' "$inputtfi" | grep -i -e 'Guess[(=]\+[^ ]*Read')" ]; then
        sed -i '1,/#/{s/#[^!]*/& Guess=Read/}' "$inputtfi"
    fi
    mv "$inputtfi" "$tempora2mt"
    mv "$temporamt" "$inputtfi"
    if [ -z "$(tail -5 "$inputtfi" | grep -e '^--Link1--')" ]; then
        echo -e "\n\n--Link1--\n" >> "$inputtfi"
    fi
    cat "$tempora2mt" >> "$inputtfi"
    rm "$tempora2mt"
}

gaussbouncer() { # CHECKS FOR CYCLING OPTIMIZATIONS AND KILLS THEM
    #trap "pkill -P ${mygorgeouspid}" SIGTERM SIGKILL SIGHUP
    while true; do
    if [ -f "$1" ]; then
        [ -n "$(echo "carefullness..."; tail -3 $1 | grep -e 'Normal termination' -e 'Error termination')" ] && exit 0
        if [ -n "$(tac $1 | sed -n '1,/ Standard orientation:/{/#/{/ Opt/Ip}}')" ]; then
            echo -e "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\nGaussbouncer will now check how the optimization is running..."
            njobbs=$(grep -c 'Normal termination' $1)
            actualfile=$(echo "$1" | sed 's/\(_1\)*.out//;s/_G[0-9]\+$/_G/')
            allactualfiles_gbcr=()
            for selfilegbcr in ${actualfile}*out; do
                if [ $(grep -c 'Entering Link 1' "$selfilegbcr") -gt 1 ]; then
                    tac "$selfilegbcr" | sed -n '1,/Entering Link 1/p' | tac > gbcr."$selfilegbcr"
                    allactualfiles_gbcr=(${allactualfiles_gbcr[@]} gbcr."$selfilegbcr")
                else
                    allactualfiles_gbcr=(${allactualfiles_gbcr[@]} "$selfilegbcr")
                fi
            done
            findminstepout="$(findminstep -j $((njobbs+1)) $(ls -l ${allactualfiles_gbcr[@]}))"
            echo "$findminstepout" | grep -e 'Cycling probably starts at' -e 'No cycling'
            if [ -n "$(echo "$findminstepout" | grep 'Cycling probably starts at')" ]; then
                [ -n "$(tail -3 $1 | grep -e 'Normal termination' -e 'Error termination')" ] && exit 0
                victimgauss=$(ps x --sort='-%cpu' | grep 'l[0-9]*.exe' | head -1 | xargs | cut -d ' ' -f 1)
                while [ -n "$(ps x --sort='-%cpu' | grep 'l[0-9]*.exe')" ]; do
                    kill $victimgauss
                    victimgauss=$(ps x --sort='-%cpu' | grep 'l[0-9]*.exe' | head -1 | xargs | cut -d ' ' -f 1)
                done
                echo "Gaussbouncer had found a target and was unleashed on it!"
                ($debugging) && echo -e "DEBUG: now output file is $(wc -c "$1") bytes long"
                echo " We must now trigger geometry solving, so let us say: Number of steps exceeded " >> "$1"
                ($debugging) && echo -e "DEBUG: and now output file is $(wc -c "$1") bytes long"
                return 1
            fi
            ($debugging) && echo -e "DEBUG: Gaussbouncer is going to sleep until its next launch...\n"
        fi
    fi
    sleep 10800 # 3 hours
    [ $tutelka -eq 0 ] && break
    done
}

cannotzero(){ # REMOVES FROM THE OUTPUT WITH SPECIAL TITLE LINE (USED FOR INTERMEDIATE JOBS LIKE Stable=Opt BETWEEN TWO GEOMETRY OPTIMIZATIONS)
    for kdgs in $(ls ${firstcurinfile%.gjf}_U*)
    do
        if [ -n "$(grep '::: 0000_000' $kdgs)" ] && [ "${kdgs%out}" != "$kdgs" ]; then
            filesiz=$(wc -c $kdgs | xargs | cut -d ' ' -f 1)
            while [ $filesiz -gt 10 ]; do
                if [ -z "$(sed -n '1,/termination/p' $kdgs | grep '000_000')" ]; then
                    sed -n '1,/termination/p' $kdgs >> $kdgs.nozero
                else
                    if [ -n "$(sed -n '1,/termination/p' $kdgs | grep -i 'SaveNTO')" ]; then
                        sed -n '1,/termination/{/Entering Link 1/,/Structure from the checkpoint file/p;}' $kdgs >> $kdgs.nozero
                        sed -n '1,/termination/p' $kdgs | grep -B 4 'Alpha virt\. eigenvalues --' | head -20 >> $kdgs.nozero
                        sed -n '1,/termination/p' $kdgs | tail -n 3 >> $kdgs.nozero
                    fi
                fi
                sed -i '1,/termination/d' $kdgs
                export filesiz=$(wc -c $kdgs | xargs | cut -d ' ' -f 1)
            done
            mv $kdgs.nozero $kdgs
        elif [ -n "$(grep '::: 0000_000' $kdgs)" ] && [ "${kdgs%gjf}" != "$kdgs" ]; then
            rm $kdgs
        fi
    done
}

lfna(){
# inp2=$(echo $2 | sed 's/\:/\\\:/g')
fstep=""; linenr=$(sed -n "$3"',/Normal termination/p' $1 | grep -m 1 -n -e "$2" | cut -d : -f 1)
[[ $3 -gt 0 ]] && linenr=$(($linenr+$3-1))
beidzis=$(sed "$linenr q;d" $1 | sed 's/^.//')
#echo "Rinda Nr $linenr"; echo "Beidzis ir $beidzis."
until [[ -n "$(echo $beidzis | grep -e "------")" ]]; do
    fstep="$fstep$beidzis"
    ((linenr++))
    beidzis=$(sed "$linenr q;d" $1 | sed 's/^.//') #; echo "Tagad beidzis ir $beidzis."
done
echo $fstep
return 0;     
}

ifind(){ # FIND THE PHRASE $2 IN THE INPUT FILE $1 NO MORE THAN $3 TIMES
    if [ -n "$3" ]; then
        vissfails=""
        dalafaila=$(cat $1)
        case "$3" in
            *[!0-9]*)
                while [ -n "$(echo "$dalafaila" | sed -n '1,/--Link1--/Ip' | grep "$3")" ]; do
                    vissfails="$vissfails\n$(echo "$dalafaila" | sed -n '1,/--Link1--/I{s/\r//g; p}')"
                    dalafaila="$(echo "$dalafaila" | sed '1,/--Link1--/Id')"
                done ;;
            *)
                for ux in $(seq 1 $3); do
                    vissfails="$vissfails\n$(echo "$dalafaila" | sed -n '1,/--Link1--/I{s/\r//g; p}')"
                    dalafaila="$(echo "$dalafaila" | sed '1,/--Link1--/Id')"
                done ;;
        esac
        echo $(echo "$vissfails" | grep -e "$2" | sed 's/^ *//;s/ *\$//')
    else
        vissfails=$(cat $1 | sed -n '1,/--Link1--/I{s/\r//g;p}')
        echo $(echo "$vissfails" | grep -m 1 -e "$2" | sed 's/^ *//;s/ *\$//')
    fi
}

ofind(){ # FIND THE PHRASE $2 IN THE OUTPUT FILE $1
    echo $(tac $1 | sed -n '1,/Entering Link 1/p' | tac | sed -n '1,/GINC/{/GINC/!{/^ '$2'/{:a;N;/----/!ba;s/[\r]*\n //g;s/--//g;s/-$//;p}; }}')
} # sarakstu2 ir versija visu tadu rindinu izvadam

getnextopt() {
    ram_getnextopt2=""
    ram_getnextopt=$(cat "$1")
    while [ -n "$ram_getnextopt" ]; do
        ram_getnextopt2="${ram_getnextopt2}$(echo;echo "$ram_getnextopt" | sed -n '1,/--Link1--/p')"
        [ -n "$(echo "$ram_getnextopt" | sed -n '1,/--Link1--/{/^#/p}' | grep -i ' Opt')" ] && break
        ram_getnextopt=$(echo "$ram_getnextopt" | sed '1,/--Link1--/d')
    done
    echo "$ram_getnextopt2" | wc -l
    return 0
}

erasedefectous() { # ERASE FROM THE INPUT FILE $icurinfile JOBS CONTAINING $1, EXCEPT IF THE JOB ALSO CONTAINS $2
    bufa_launch=""
    echo -e "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n"
    echo -e  "E R A S I N G   D E F E C T O U S   J O B S\n" 
    ($debugging) && echo "DEBUG: enter erasedefectous($1)"
    echo -e "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n"
    trinfile=$(echo "$icurinfile" | sed 's/\(_[0-9G]\+\)*.gjf//' )
    nowlutil_nr=${trinfile##*_U}
    trinfile="${firstcurinfile%.gjf}_U$((nowlutil_nr+1)).gjf"
    notrinfile=false; edctrl=0
    for sweptfile in "$icurinfile" "$trinfile"; do
        swnrdone=$nrdone
        edctrl=$((edctrl+1))
        #echo "Remain $(less $icurinfile | grep -c "$prechk") such CHK"
        [ "$sweptfile" == "$trinfile" ] && ($notrinfile) && break
        echo -e "Searching in the file \" $sweptfile \" for defectous line:\n$1\n..."
        dos2unix $icurinfile 2> /dev/null
        [ -n "$2" ] && echo -e "Will omit if the following is found:\n$2\n..."
        until [[ -z $(less $sweptfile | grep -c -e "$1") ]]; do
            #echo "Remain $(less $sweptfile | grep -c "$prechk") instances of this defectous phrase"
            curchk=$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -e "$1") # considering next lines: I tried to use =~, but on some machines bash was too old, even shopt -s extglob did not help
            echo -n "Defectous phrase found..."
            if [ ".${1##*.}" == '.chk' ]; then
                [ -f "$1" ] && rm "$1" || echo "The troublesome checkpoint file is not found..."
                { [ -z "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -E -i 'Geom[=(]*Check|Guess[^ ]*Read|Guess[^ ]*TCheck|NonEq=Read|ReadFC')" ] || [ -z "$(echo $curchk | tr -d ' ')" ]; } && { [ -n "$curchk" ] && echo " but the job is not removed because information from the CHK is not going to be used."; curchk=""; }
                [ -n "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i '^%OldChk=')" ] && [ -z "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i 'OldChk='"$1")" ] && { [ -n "$curchk" ] && echo " but the job is not removed because it is overwritten with some other checkpoint."; curchk=""; break 2; }
                echo -e "See: \n$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i 'OldChk=')\nSaw?"
                if [ -n "$(sed -n '1,/--Link1--/I{/^ *[A-Za-z][a-z]\{0,1\}\([-]\{1,2\}[[:alnum:].]\+\)*\(([[:alnum:]=,.]\+)\)*\([ ,\t]\+[-]*[0-9]\+\.[0-9]\+\)\{3\}[ \t]*$/p}' $sweptfile)" ]; then
                    [ -n "$curchk" ] && echo " but the job is not removed because a brand new geometry is used instead."
                    curchk=""
                    [ -n "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i '^%Chk='"$1")" ] && echo "Also, this new geometry will now replace whatever bad was there in that failed .CHK file; hence the erasing must stop now." && break 2
                fi
                [ -z "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i -E 'Geom[=(]*Check|Guess[^ ]*Read|Guess[^ ]*TCheck|NonEq=Read|ReadFC')" ] && [ -n "$curchk" ] && { echo " but somehow the job will not be deleted because some unrealistic condition has been satisfied!"; break 2; } # it means the defectous CHK gets overwritten by some next task`
                [ -z "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i -E 'NonEq=Read')" ] && [ -n "$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -i -E ' Opt')" ] && [ -z "$(cat $curoutfile | grep -e "Atoms too close" -e 'Problem with the distance matrix')" ] && [ -n "$curchk" ] && sed -i '1,/--Link1--/I{/#/{s/\(Guess[^ ]*\)Read\([^ ]*\)/\1,\2/;s/(,/(/g;s/,)/)/g;s/=,/=/g;s/,,/,/g; s/ Guess[=()]*//}}' "$sweptfile" && { echo " but the job is not removed because there is a chance that the geometry is not corrupted and gets modified during the optimization in this job."; break 2; } # it means the defectous CHK gets overwritten by the geometry optimization
            fi
            [ "${1: -1}" == '/' ] && [ -z "$(sed -n '1,/#/n;p' $sweptfile | grep -i -E 'DCSHG|ExternalIteration')" ] && [ -z "$(sed -n '1,/^#/n;p' $sweptfile | grep -i -e ' TD[=(]' -e ' CIS[=(]' -e ' EOM' -e 'SAC-CI')" ] && { curchk=""; echo "but the job is not removed because it does not involve second derivatives by field or excited state calculations."; }
            echo # in case it was neither CHK nor functional name
            if ($debugging); then
                [ -n "$curchk" ] && echo "So, the following job will be removed:" || echo "So, the following job will NOT be removed:"
                ifind $sweptfile '^#' | sed 's/\r//'
                ifind $sweptfile ':::' | sed 's/\r//'
                echo
            fi

            #echo "Curchk is $curchk"
        #        curprim=$(echo $curchk | sed 's/\%[A-Z]*[a-z]*Chk=//')
        #        echo "### Found the defectous phrase $curcheck..."
            # failedstep=$(ifind $sweptfile ':::' | sed 's/\r//') only needed if the line two lines below is not commented out
            #[[ ".${1##*.}" == '.chk' ]] && ( $multistepchk ) && [ -n "$(echo $failedstep | grep -i ' Opt')" ] && [ -z "$(cat $curoutfile | grep -e "Atoms too close" -e 'Problem with the distance matrix')" ] && break;

            swfilesiz=$(wc -c < $sweptfile)
            ($debugging) && echo "DEBUG: Processed input file size is: $swfilesiz"
            ($debugging) && echo "DEBUG: Now will erase defectous jobs or save jobs to the buffer, until there are no defectous jobs."
            if [ -n "$curchk" ] && [ $swfilesiz -gt 0 ]; then
                ($debugging) && echo -n "W" || echo -n "Erasing defectous, w"
                echo "riting the job to ${firstcurinfile%.gjf}_failed.gjf..."
                [ -z "$(tail -7 ${firstcurinfile%.gjf}_failed.gjf 2>/dev/null | grep -i '\-\-Link1\-\-')" ] && echo -en "\n--Link1--\n\n" >> ${firstcurinfile%.gjf}_failed.gjf
                echo '!the following comes from: '"$sweptfile" >> ${firstcurinfile%.gjf}_failed.gjf
                deathrow="$(sed -n '1,/--Link1--/Ip' $sweptfile | tee -a ${firstcurinfile%.gjf}_failed.gjf)" # added since v. 0.4.0.9
                ($debugging) && echo "DEBUG: erasedefectous: Icurinfile is $sweptfile, while the first argument is $1"
                if [ -n "$(echo "$deathrow" | grep '^[[:space:]]*!lutil')" ]; then
                    sed -n '/\!lutil/,$p' -i $sweptfile
                else
                    sed '1,/--Link1--/Id' -i $sweptfile # deletes everything until the first "--Link1--", including that line
                fi
                swfilesiz=$(wc -c < $sweptfile)
                until [[ -n "$(head -n 1 "$sweptfile" | grep "%")" ]] || [[ $swfilesiz -lt 20 ]]; do
                    sed '1 d' -i $sweptfile; swfilesiz=$(wc -c < $sweptfile)
                    swfilesiz=$(wc -c < $sweptfile)
                done
                ((swnrdone++))
                echo "Shifting as-if-done jobs number to $swnrdone..."
                markkkerrr=false
                if [ -z "$(echo "$sweptfile" | grep -o '_U[0-9]\+.gjf')" ]; then
                    mv $sweptfile ${sweptfile%_*}_$((swnrdone+1)).gjf
                    [ "$icurinfile" == "$sweptfile" ] && markkkerrr=true
                    sweptfile=${sweptfile%_*}_$((swnrdone+1)).gjf
                    swicuroutfile=${sweptfile%_*}_$((swnrdone+1)).out
                    ($markkkerrr) && export icurinfile="$sweptfile"
                    ($markkkerrr) && export icuroutfile="$swicuroutfile"
                fi
                unset markkkerrr
                echo "### Removed job that used the defectous phrase '$prechk'..."
            elif [[ $swfilesiz -lt 20 ]] || [ -z "$(grep '^[ ]*#' $sweptfile)" ]; then
                ($debugging) && echo "DEBUG: processed file size is $swfilesiz, size of the buffer with jobs not containing the defectous phrase is ${#bufa_launch}"
                [ ${#bufa_launch} -lt 2 ] && echo "### Deleted all remaining jobs. Exiting." || echo "### Checked for defectous lines all remaining jobs."
                break
            else
                ($debugging) && echo -e "DEBUG: adding to the buffer the following job:\n$(sed -n '1,/--Link1--/Ip' $sweptfile | grep -e '^#' -A 2)"
                bufa_launch="$(echo -e "$bufa_launch\n")$(sed -n '1,/--Link1--/Ip' $sweptfile)"; sed -i '1,/--Link1--/Id' $sweptfile
                ($debugging) && echo "DEBUG: buffer with jobs not containing the defectous phrase is that big: ${#bufa_launch[@]}"
            fi
            swfilesiz=$(wc -l < $sweptfile)
        done
        #[[ -f bufa_launch ]] && (echo ""; echo "-----------------"; echo ""; echo "###Buffered jobs are $(cat bufa_launch | grep -E '#|:::')"; echo ""; echo "-----------------"; echo "")
        bufa_launch="$(echo -e "$bufa_launch\n")$(sed -n '1,/--Link1--/Ip' $sweptfile)"
        ($debugging) && echo "DEBUG: now, in the end, buffer with jobs not containing the defectous phrase is that big: ${#bufa_launch}"
        echo "$bufa_launch" > $sweptfile
        swfilesiz=$(wc -c < $sweptfile)
        ($debugging) && echo "DEBUG: Processed input file size is, in the end, $swfilesiz"
        #filsiz=2
        until [[ -n "$(head -n 1 "$sweptfile" | grep "%")" ]] || [[ $swfilesiz -lt 3 ]]; do
                sed '1 d' -i $sweptfile
                swfilesiz=$(wc -c < $sweptfile)
        done
        if [ $edctrl -eq 1 ]; then
            export nrdone=$swnrdone; export filesiz=$swfilesiz
            export icurinfile=$sweptfile; export icuroutfile=$swicuroutfile
        fi
    done
    echo -e "\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n"
} # erasedefectous ends here

casmonkey() { # NOT FINISHED YET
    nelec=$2; norbi=$3; noccu=$((nelec/2)); nunoc=$((norbi-noccu))
    echo "CAS Monkey started doing its monkey job!"
    if [ "$1" == "w" ]; then
        echo "Generating orbital alterations..."
        orbsymsfile=$newest_out; [ -z "$orbsymsfile" ] && read -p "Please enter the filename of the guess file:   " orbsymsfile
        myoutput=$(tac $orbsymsfile | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Orbital symmetries:/,/Virtual  /p')
        virtusym="$(echo "$myoutput" | tail -1 | sed 's/^[^(]*//')"
        occusym="$(echo "$myoutput" | sed '$d' | sed ':a;N;$!ba;s/^[^(]*//;s/\n/ /g' | tr -s ' ')"
        ($debugging) && { echo "DEBUG: Occusym:"; echo $occusym; }
        ($debugging) && { echo "DEBUG: Virtusym:"; echo $virtusym; }
        hosym="$(echo "$occusym" | rev | cut -d ' ' -f 1 | rev)"
        lusym="$(echo "$virtusym" | cut -d ' ' -f 1)"
        ($debugging) && echo "DEBUG: Hosym: $hosym"
        echo "Symmetry of LUMO is $lusym, used as a reference point."
        aso="$(echo "$occusym" | rev | cut -d ' ' -f 1-$noccu | rev)"
        ($debugging) && { echo "DEBUG: Aso:"; echo ${aso[@]}; }
        asu="$(echo "$virtusym" | cut -d ' ' -f 1-$nunoc)"
        ($debugging) && { echo "DEBUG: Asu:"; echo ${asu[@]}; }
        nomo="${occusym//\(/}"
        nomo=$((${#occusym}-${#nomo}))
        ($debugging) && echo "DEBUG: Number of OMOs: $nomo"

### Producing orbital lists
#### OMOs
        aso=($(echo ${aso[@]} | rev)) # since now, aso and its elements are in reverse
        for webdi in $(seq 0 $((noccu-1))); do
            [ "$(echo ${aso[$webdi]} | rev)" != "$lusym" ] && occord=(${occord[@]} $((nomo-webdi))) || occord2=(${occord2[@]} $((nomo-webdi)))
        done
        occord=(${occord[@]} ${occord2[@]}); unset occord2
        echo "Occupied orbitals to exchange:"; echo "${occord[@]}"
        occusym=($(echo $occusym | rev)) # since now, occusym and its elements are in reverse
        [ $((nomo-noccu)) -lt 10 ] && ocuspan=$((nomo-noccu)) || ocuspan=10
        for webdi in $(seq $noccu $((noccu+ocuspan))); do
            [ "$(echo ${occusym[$webdi]} | rev)" == "$lusym" ] && occord2=(${occord2[@]} $((nomo-webdi))) || occord3=(${occord3[@]} $((nomo-webdi)))
        done
        occord2=(${occord2[@]} ${occord3[@]}); unset occord3
        echo "Occupied orbitals to use for exchange:"; echo "${occord2[@]}"

#### UMOs
        for webdi in $(seq 0 $((nunoc-1))); do
            [ "${asu[$webdi]}" != "$lusym" ] && uncord=(${uncord[@]} $((nomo+webdi+1))) || uncord2=(${uncord2[@]} $((nomo+webdi+1)))
        done
        uncord=(${uncord[@]} ${uncord2[@]}); unset uncord2
        echo "Unoccupied orbitals to exchange:"; echo "${uncord[@]}"
        virtusym=($(echo $virtusym))
        numo=${#virtusym[@]}
        [ $((numo-nunoc-1)) -lt 10 ] && virspan=$((numo-nunoc-1)) || virspan=10
        for webdi in $(seq $nunoc $((virspan+nunoc))); do
            [ "${virtusym[$webdi]}" == "$lusym" ] && uncord2=(${uncord2[@]} $((nomo+webdi+1))) || uncord3=(${uncord3[@]} $((nomo+webdi+1))) # +1 because nomo is # of OMOs
        done
        uncord2=(${uncord2[@]} ${uncord3[@]}); unset uncord3
        echo "Unoccupied orbitals to use for exchange:"; echo "${uncord2[@]}"

### Writing combinations of them to the file ./casbaboon; upon reading them in, the first line is read (head -1_ and then deleted (sed '1d')
        [ -f casbaboon ] && rm casbaboon
        > casbaboon
        for ape2 in ${occord[@]}; do
            for ape3 in ${occord2[@]}; do
                echo "$ape2,$ape3" >> casbaboon
            done
        done
        for ape2 in ${uncord[@]}; do
            for ape3 in ${uncord2[@]}; do
                echo "$ape2,$ape3" >> casbaboon
            done
        done
        echo "Written single obital exchange combinations to ./casbaboon file"

        [ -f casbaboon2 ] && rm casbaboon2
        > casbaboon2
        for ape2 in ${occord[@]}; do
            for ape3 in ${occord2[@]}; do
                for ape4 in ${uncord[@]}; do
                    for ape5 in ${uncord2[@]}; do
                        echo "$ape2,$ape3" >> casbaboon2
                        echo "$ape4,$ape5" >> casbaboon2
                    done
                done
            done
        done
        echo "Written double obital exchange combinations to ./casbaboon2 file"

## Time to apply what we got! Looping over  all exchange pairs
    else
        for macaque in $(seq 1 $(wc -l < casbaboon)); do
            cp $curinfile ${curinfile%.gjf}_C$macaque.gjf
            sed -i '1,/Link1/I{/###/!{/#/s/#[^!]*/& Guess=Alter/;s/CAS_CAPUCHINE/'"$(head -1 casbaboon)"'/}}' ${curinfile%.gjf}_C$macaque.gjf
            sed '1d' ${curinfile%.gjf}_C$macaque.gjf
            until [ $tutelka -eq 0 ]; do
                checkout ${curinfile%.gjf}_C$macaque.gjf ${curoutfile%.out}_C$macaque.out && tutelka=0 || { sed -i '/^:::/s/_/\//g' ${curinfile%.gjf}_C$macaque.gjf; g09 < ${curinfile%.gjf}_C$macaque.gjf > ${curoutfile%.out}_C$macaque.out; exitcodd=$?; sed -i '/GINC/,/ob cpu tim/!{/^ :::/,/---/s/\//_/g}' ${curoutfile%.out}_C$macaque.out; }
            done
        done
        catarrchine=macaque
        for macaque in $(seq 1 $(wc -l < casbaboon2)); do
            cp $curinfile ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf
            sed -i '1,/Link1/I{/###/!{/#/s/#[^!]*/& Guess=Alter/;s/CAS_CAPUCHINE/'"$(head -2 casbaboon2)"'/}}' ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf
            sed '2d' ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf
            until [ $tutelka -eq 0 ]; do
                checkout ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf ${curoutfile%.out}_C$((catarrchine+macaque)).out && tutelka=0 || { sed -i '/^:::/s/_/\//g' ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf; g09 < ${curinfile%.gjf}_C$((catarrchine+macaque)).gjf > ${curoutfile%.out}_C$((catarrchine+macaque)).out; exitcodd=$?; sed -i '/GINC/,/ob cpu tim/!{/^ :::/,/---/s/\//_/g}' ${curoutfile%.out}_C$((catarrchine+macaque)).out; }
            done
        done
    fi
}

imgsolver() {
# I must refer here to pyQRC by  Robert Paton (https://github.com/bobbypaton/pyQRC/blob/master/LICENSE) which helped a lot to understand how to actually shift the geometry (simple things are not obvious for everyone, duh)
    findmingeom -xlj "$totlines" "$2" saddlegeom.${HOSTNAME}.xyz
    tac "$2" | sed -n '1,/imaginary frequencies (negative Sig/p' | tac | sed '1,/^  Atom  AN/d;/^                      4/,$d' | gawk '{print $3 " " $4 " " $5}' > shiftgeom.${HOSTNAME}.gem
    shift_coords.py saddlegeom.${HOSTNAME}.xyz shiftgeom.${HOSTNAME}.gem offsaddlegeom.${HOSTNAME}.xyz
    if [ -n "$(tac "$2" | sed -n '/2 imaginary frequencies (negative Sig/p')" ]; then
        tac "$2" | sed -n '1,/imaginary frequencies (negative Sig/p' | tac | sed '1,/^  Atom  AN/d;/^                      4/,$d' | gawk '{print $6 " " $7 " " $8 " "}' > shiftgeom.${HOSTNAME}.gem
        shift_coords.py offsaddlegeom.${HOSTNAME}.xyz shiftgeom.${HOSTNAME}.gem offsaddlegeom2.${HOSTNAME}.xyz
        mv -f offsaddlegeom2.${HOSTNAME}.xyz offsaddlegeom.${HOSTNAME}.xyz
    fi
    ($debugging) && echo "DEBUG: Using the imaginary frequency solver..."
    geomfromdone "$icurinfile" offsaddlegeom.${HOSTNAME}.xyz "$nrdone" "$totlines" 0 "$debugging" || { echo "Solving the imaginary frequency problem failed! Aborting."; rm offsaddlegeom.${HOSTNAME}.xyz offsaddlegeom2.${HOSTNAME}.xyz shiftgeom.${HOSTNAME}.gem saddlegeom.${HOSTNAME}.xyz; return 7; }
    rm offsaddlegeom.${HOSTNAME}.xyz shiftgeom.${HOSTNAME}.gem saddlegeom.${HOSTNAME}.xyz
    [ -f offsaddlegeom2.${HOSTNAME}.xyz ] && rm offsaddlegeom2.${HOSTNAME}.xyz
}
mcscfsolver() {
    if [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5/7=')" ]; then
        sed -i '/###/!{/#/{s/#[^!]*/& IOp(5\/7=128)/;:a;n;ba}}' $icurinfile
    else
        sed -i '/###/!{/#/{s/IOp(5\/7=[^,) ]*/IOp(5\/7=256/;:a;n;ba}}' $icurinfile
    fi
}
scfsolver() {
    endsolvhere=$(getnextopt "$icurinfile")
    realfailedsteproute="$failedsteproute"
    if [ -n "$(tail -n 20 $2 | grep "Inaccurate quadrature in CalDSu")" ] && [ -z "$(echo "$failedsteproute" | grep -i 'Guess[^ ]*INDO')" ]; then
       export solveacc2=3
       if [ -z "$(echo "$failedsteproute" | grep -i -e UltraFine -e SuperFine)" ] && [ -n "$(grep "This is part of the Gaussian(R) 09 program." $2)" ]; then 
           echo -e "\nUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfi\n"
           if (! $gofiner); then
               echo "Please consider using Integral=UltrafineGrid!"
           else
               echo "Changing grid to UltraFine..."
               wasgrid=$(echo "$failedsteproute" | grep -o -e '\b[gG][Rr][Ii][Dd]=[^ ,)]*' -e '\b[Ii][Nn][Tt][Ee]*[Gg]*[Rr]*[Aa]*[Ll]*[=(]\+[^\s]*\([[:alnum:]][Gg][Rr][Ii][Dd]\)')
               if [ -n "$wasgrid" ]; then
                   sed -i '/#/{s/\(.*grid=\)[^ ,)]\+/\1UltraFine/I;s/\(Int[e]*[g]*[r]*[a]*[l]*[=(]\+[^\s]*\)[[:alnum:]][Gg][Rr][Ii][Dd]/\1UltraFineGrid/I;:a;n;ba}' "$icurinfile"
               else
                   sed -i '/#/{s/#[^!]*/& Integral=UltraFineGrid/;:a;n;ba}' $icurinfile
               fi
           fi
           echo -e "\nUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfiUfi\n"
       elif [ -z "$(echo "$failedsteproute" | grep -i -e SuperFine)" ] && [ -n "$(grep "This is part of the Gaussian(R) 16 program." $2)" ]; then
           echo -e "\nSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfi\n"
           if (! $gofiner); then
               echo "Please consider using Integral=SuperFineGrid!"
           else
               echo "Changing grid to SuperFine..."
               wasgrid=$(echo "$failedsteproute" | grep -o -e '\b[gG][Rr][Ii][Dd]=[^ ,)]*' -e '\b[Ii][Nn][Tt][Ee]*[Gg]*[Rr]*[Aa]*[Ll]*[=(]\+[^\s]*\([[:alnum:]][Gg][Rr][Ii][Dd]\)')
               if [ -n "$wasgrid" ]; then
                   sed -i '/#/{s/\(.*grid=\)[^ ,)]\+/\1SuperFine/I;s/\(Int[e]*[g]*[r]*[a]*[l]*[=(]\+[^\s]*\)[[:alnum:]][Gg][Rr][Ii][Dd]/\1SuperFineGrid/I;:a;n;ba}' "$icurinfile"
               else
                   sed -i '/#/{s/#[^!]*/& Integral=SuperFineGrid/;:a;n;ba}' $icurinfile
               fi
           fi
           echo -e "\nSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfiSfi\n"
       fi
       wasguess=$(echo "$failedsteproute" | grep -o '[gG]uess[=(][^ ]*')
       if [ -n "$wasguess" ]; then
           modguess=$(echo "($wasguess)" | sed 's/Read//I;s/TCheck//I;s/(Guess[=(]*/Guess=(INDO,/I;s/,)/)/;s/(,/(/;s/Guess[=]*()//I')
           sed -i '/#/{s/'$wasguess'/'$modguess'/;:a;n;ba}' $icurinfile
       else
           sed -i '/#/{s/#[^!]*/& Guess=INDO/;:a;n;ba}' $icurinfile
       fi
       #  #  if Integral=UltraFine is not helping, sometimes, people say, the problem is the guess (see, e.g., https://www.researchgate.net/post/Does_any_one_know_how_to_troubleshoot_an_optimization_terminated_with_error_Inaccurate_quadrature_in_CalDSu
    elif [ -n "$(tail -n 20 $2 | grep "CPHF failed to converge")" ]; then
        solvecphf=3; solveacc2=3; echo "CPHF not converged. Must work with tighter integral accuracy..."
        #[ "${2: -12}" == "_1_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvecphf=0; }
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvecphf=0; }
        #fi
    else # if the error was not about the integration...
        [ -z "$(echo "$failedsteproute" | grep -i 'SCF')" ] && sed -i '1,'"$endsolvhere"'{/#/s/#[^!]*/& SCF=(IntRep,NoVarAcc)/}' $icurinfile
        failedsteproute=$(ifind $icurinfile "#")
        [ -z "$(echo "$failedsteproute" | grep -i 'SCF[=]*(')" ] && { sed -i '1,/#/s/SCF[=]*[^ ]*/(&)/I' $icurinfile ; sed -i '1,/#/{s/(SCF=/SCF=(/I;s/(SCF/SCF=(/I}' $icurinfile; }
        failedsteproute=$(ifind $icurinfile "#")
        [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i 'NoVarAcc')" ] && sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/&NoVarAcc,/I}' $icurinfile
        failedsteproute=$(ifind $icurinfile "#")
        [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i 'IntRep')" ] && sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/&IntRep,/I}' $icurinfile
        failedsteproute=$(ifind $icurinfile "#")
        [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i 'NoIncFock')" ] && sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/&NoIncFock,/I}' $icurinfile
        failedsteproute=$(ifind $icurinfile "#")
        if [ -n "$(tail -20 $2 | grep -e 'No SCF=DM or SCF=QC with SCI-PCM')" ]; then
            sed -i '/#/{s/\(SCF[^ ]*\)YQC/\1/;s/\(SCF[^ ]*\)XQC/\1/;s/\(SCF[^ ]*\)QC/\1/' $icurinfile
        fi
        if [ -n "$(tail -20 $2 | grep -e 'o lower point found -- run abo' -e 'Convergence failure\.')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'scipcm')" ]; then
           export solveacc2=3
           echo "Please consider using Integral=UltrafineGrid!"
           [ -n "$(echo "$failedsteproute" | grep -i 'YQC')" ] && sed -i '1,'"$endsolvhere"'{/#/s/YQC/XQC/I}' $icurinfile 
           # specific case: steepest descent failed
           myL508maxNR=$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -o '[Mm]ax[Nn][Rr]=[0-9]\+' | cut -d '=' -f 2)
           if [ -z "$(echo "$failedsteproute" | grep -i 'FullLinear')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(FullLinear,/I}' $icurinfile
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'VTL' -e 'VeryTightLin')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(VTL,/I}' "$icurinfile"
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'DM')" ]; then # direct minimization with classic Roothaan SCF
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(DM,/I}' "$icurinfile"
               sed -i '/#/{s/#[^!]*/& IOp(5\/8=2)/I;:a;n;ba}' $icurinfile
           elif [ -n "$(echo "$failedsteproute" | grep -i -e 'IOp([^)]*5\/8=2')" ]; then # direct minimization with conjugate gradient
               sed -i '1,'"$endsolvhere"'{/#/s@\(IOp([^)]*\)5/8=2@\15/8=4@I}' "$icurinfile"
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'VShift')" ]; then # adding an additional job with shifted levels and using it as a new quess
               copyfirst "$icurinfile"
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[^)]*/SCF=VShift/I}' "$icurinfile"
           #1-desperate: Adding QC
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i '[YX]*QC')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'scipcm')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(YQC,MaxConventionalCyc=40,/I}' $icurinfile
           #2-desperate: Adding Fermi broadening
           elif [ -z "$(echo "$failedsteproute" | grep -i 'Fermi')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(Fermi,/I}' $icurinfile
           # the MaxNR option has an effect only on L508
           elif [ -n "$myL508maxNR" ] && ($banginghead); then
               case $myL508maxNR in
                   2)
                       sed -i '1,'"$endsolvhere"'{/#/s/MaxNR=2/MaxNR=3/I}' $icurinfile
                       ;;
                   3)
                       sed -i '1,'"$endsolvhere"'{/#/s/MaxNR=3/MaxNR=4/I}' $icurinfile
                       ;;
                   4)
                       [ -z "$(echo "$failedsteproute" | grep -i '5\/8=1114')" ] && sed -i '1,'"$endsolvhere"'{/#/s/^#[^!]*/& IOp(5\/8=1114)/}' $icurinfile # switch to DIIS early
                       ;;
               esac
           elif ($banginghead); then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(MaxNR=3,/I}' $icurinfile
           fi
        elif [ -n "$(echo "$failedsteproute" | grep -i 'scipcm')" ] ; then
           ##### SCI-PCM FAILURE #####
           wasdamped=$(tac $2 | sed -n '1,/Cycle   1  Pass 1/p' | grep -c ' Damp=T')
           irdamp=$(echo "$failedsteproute" | grep -o '[Nn][Dd]amp=[^,)]' | cut -d '=' -f 2)
           echo "Damping is now $irdamp"
           #1: Adding damping
           if [ -z "$(echo "$failedsteproute" | grep -i '[,(]Damp')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(Damp,/I}' $icurinfile
           #2a: Damping more
           elif [ -n "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 20 ] || [ -z "$irdamp" ]; } && ($banginghead); then # [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ]
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!*/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '1,'"$endsolvhere"'{/#/s/NDamp=[^,)]//I;s/SCF[=(]*/SCF=(NDamp=20,/I}' $icurinfile # default: 10
               [ $wasdamped -lt 10 ] && sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) IOp(5/108=10) !/ }' $icurinfile # 5/18=50: mixing half of old density while damping; 5/21=5: damp even when the error is as low as 10E-5 (defaul 10E-3); 5/108=10: minimum number of iterations to use damping
           #3: Tighter thresholds for linear equation, good for semi-linear cases
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -e 'VTL' -e 'VeryTightLin')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(VTL,/I}' "$icurinfile"
           #2b: Damping, damping...
           elif [ -n "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 75 ]; }; then
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*NDamp\)=[^,)]*/\1=75,/I}' $icurinfile
               [ $wasdamped -lt 20 ] && sed -i '/#/{s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) !/ }' $icurinfile
           #2c: Turning on the commutator instead of mix of energy and commutator
           elif [ -z "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && ($banginghead); then
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '/#/{s/SCF[=(]*/SCF=(CDIIS,/I;s/\(.*\)!/\1 IOp(5\/20=1) !/ }' $icurinfile
           #4: Full linear search even if the initial microiteration was successful
           elif [ -z "$(echo "$failedsteproute" | grep -i 'FullLinear')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(FullLinear,/I}' $icurinfile
           #5: no CDIIS, but Damp
           elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && [ -z "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && ($banginghead); then
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '1,'"$endsolvhere"'{/#/s/\(CDIIS\)\(.*\)!/Damp\2 !/ }' $icurinfile
           #6: Adding Fermi broadening
           elif [ -z "$(echo "$failedsteproute" | grep -i 'Fermi')" ]; then
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(Fermi,/I}' $icurinfile
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'VShift')" ]; then # adding an additional job with shifted levels and using it as a new quess
               copyfirst "$icurinfile"
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[^)]*/SCF=VShift/I}' "$icurinfile"
           #7: KyDiag # probably irrelevant...
           elif [ -n "$(echo "$failedsteproute" | grep -i 'NDamp=75')" ] && ($banginghead); then
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*\)NDamp=[^,)]*/\1/I;s/(,/(/;s/,,/,/;s/,)/)/;s/\(.*\)!/\1 IOp(5\/16=2) !/ }' $icurinfile
           #8: Jacobi diagonalization (old, slow but robust) # probably irrelevant...
           elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(5\/16=2)')" ] && ($banginghead); then
               wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
               for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
               sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/16=10) !/ }' $icurinfile
           fi
           [ "$realfailedsteproute" != "$failedsteproute" ] && echo "0" > scfsolver.$HOSTNAME.tmp || echo "3" > scfsolver.$HOSTNAME.tmp
        elif [ -z "$(echo "$failedsteproute" | grep -o '[rR][oO][^ /]*/')" ]; then # most freqent case
            wasdamped=$(tac $2 | sed -n '1,/Cycle   1  Pass 1/p' | grep -c ' Damp=T')
            irdamp=$(echo "$failedsteproute" | grep -o '[Nn][Dd]amp=[^,)]' | cut -d '=' -f 2)
            #1: Adding YQC
            if [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i 'YQC')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'scipcm')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(YQC,MaxConventionalCyc=40,/I}' $icurinfile
            #2: Adding Fermi broadening
            elif [ -z "$(echo "$failedsteproute" | grep -i 'Fermi')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(Fermi,/I}' $icurinfile
          #      #3: Tightening threshold for switching to the commutator
          #      elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=204')" ]; then
          #          wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
          #          for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
          #          sed -i '/#/{s/#[^!]*/& IOp(5\/22=2043)/I;:a;n;ba}' $icurinfile
            #3a: Further tightening threshold for switching to the commutator
            elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=304')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/#[^!]*/& IOp(5\/22=3043) /I}' $icurinfile
            #3b: Adding an additional job with shifted levels and using it as a new quess
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'VShift')" ]; then
               copyfirst "$icurinfile"
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[^)]*/SCF=VShift/I}' "$icurinfile"
            #4: Turning the commutator off altogether and switching to EDIIS, also disabling Fermi
            elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ]; then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(NoDamp,/I;s/\(SCF[^ )]*\)Fermi[,]*/\1/I}' $icurinfile
                sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/22=23) !/}' $icurinfile
            #5: Turning EDIIS off and turning on the commutator and the damping
            elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'CDIIS')" ]; then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ )]*\)NoDamp[,]*/\1/I}' $icurinfile
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(CDIIS,/I}' $icurinfile
            #6: Tighter thresholds for linear equation, good for semi-linear cases
            elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -e 'VTL' -e 'VeryTightLin')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(VTL,/I}' "$icurinfile"
            #5a: Damping more
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 20 ] || [ -z "$irdamp" ]; } && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(NDamp=20,Fermi,/I}' $icurinfile # default: 10
                [ $wasdamped -lt 10 ] && sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) IOp(5/108=10) !/ }' $icurinfile
            #5c: Damping ultimately
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 75 ]; } && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*NDamp\)=[^,)]*/\1=75,/I}' $icurinfile
                [ $wasdamped -lt 20 ] && sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) !/ }' $icurinfile
            #7: Full linear search even if the initial microiteration was successful
            elif [ -z "$(echo "$failedsteproute" | grep -i 'FullLinear')" ] && ($banginghead); then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(FullLinear,/I}' $icurinfile
            #8: no CDIIS, but Damp
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && [ -z "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(CDIIS\)\(.*\)!/Damp\2 !/ }' $icurinfile
            #9: FERMI again
            elif [ -n "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\([,(]\)\(Damp\)\(.*\)!/\1Fermi\2 !/ }' $icurinfile
            #10: KyDiag
            elif [ -n "$(echo "$failedsteproute" | grep -i 'NDamp=75')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*\)NDamp=[^,)]*/\1/I;s/(,/(/;s/,,/,/;s/,)/)/;s/\(.*\)!/\1 IOp(5\/16=2) !/ }' $icurinfile
            #11: Jacobi diagonalization (old, slow but robust)
            elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(5\/16=2)')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/16=10) !/ }' $icurinfile
            #12: Instead of YQC, using QC from the very beginning (I doubt this is a good solution)
            elif [ -n "$(echo "$failedsteproute" | grep -i 'YQC')" ] && ($banginghead); then
                sed -i '1,'"$endsolvhere"'{/#/s/YQC/QC/I}' $icurinfile
            #13: Instead of QC or else, using DM
            elif [ -n "$(echo "$failedsteproute" | grep -i -e 'YQC' -e 'DIIS')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'scipcm')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/[^,(]*QC,//I;s/CDIIS/DM/I}' $icurinfile
            fi
        else # if this is an ROHF/ROKS calculation...
            wasdamped=$(tac $2 | sed -n '1,/Cycle   1  Pass 1/p' | grep -c ' Damp=T')
            irdamp=$(echo "$failedsteproute" | grep -o '[Nn][Dd]amp=[^,)]' | cut -d '=' -f 2)
            #1: Switching to Link 506 instead of L502
            if [ -z "$(echo "$failedsteproute" | grep -i 'Use=L506')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/#[^!]*/& Use=L506/}' $icurinfile
            #2: Adding Fermi broadening
            elif [ -z "$(echo "$failedsteproute" | grep -i 'Fermi')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(Fermi,/I}' $icurinfile
          #      #3: Tightening threshold for switching to the commutator
          #      elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=204')" ]; then
          #          wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
          #          for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
          #          sed -i '/#/{s/#[^!]*/& IOp(5\/22=2043)/I;:a;n;ba}' $icurinfile
            #3a: Further tightening threshold for switching to the commutator
            elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=304')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/#[^!]*/& IOp(5\/22=3043) /I}' $icurinfile
            #3b: Adding an additional job with shifted levels and using it as a new quess
           elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -i -e 'VShift')" ]; then
               copyfirst "$icurinfile"
               sed -i '1,'"$endsolvhere"'{/#/s/SCF[^)]*/SCF=VShift/I}' "$icurinfile"
            #4: Turning the commutator off altogether and switching to EDIIS, also disabling Fermi
            elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ]; then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(NoDamp,/I;s/\(SCF[^ ]*\)Fermi[,]*/\1/I}' $icurinfile
                sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/22=23) !/}' $icurinfile
            #5: Turning EDIIS off and turning on the commutator but implicitly adding damping
            elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(5\/22=2[23]')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'CDIIS')" ]; then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*\)NoDamp[,]*/\1/I}' $icurinfile
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(CDIIS,/I}' $icurinfile
            #6: Tighter thresholds for linear equation, good for semi-linear cases
            elif [ -z "$(echo "$failedsteproute" | grep -o '[sS][cC][fF][=(][^ ]*' | grep -e 'VTL' -e 'VeryTightLin')" ]; then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(VTL,/I}' "$icurinfile"
            #5a: Damping more
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 20 ] || [ -z "$irdamp" ]; } && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(NDamp=20,/I}' $icurinfile # default: 10
                [ $wasdamped -lt 10 ] && sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) IOp(5/108=10) !/ }' $icurinfile
            #5c: Damping, damping...
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && { [ -n "$irdamp" ] && [ "$irdamp" -lt 75 ]; } && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/18=[^ ]*' -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*NDamp\)=[^,)]*/\1=75,/I}' $icurinfile
                [ $wasdamped -lt 20 ] && sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/18=50) IOp(5\/21=5) !/ }' $icurinfile
            #7: Full linear search even if the initial microiteration was successful
            elif [ -z "$(echo "$failedsteproute" | grep -i 'FullLinear')" ] && ($banginghead); then
                sed -i '1,'"$endsolvhere"'{/#/s/SCF[=(]*/SCF=(FullLinear,/I}' $icurinfile
            #8: no CDIIS, but Damp
            elif [ -n "$(echo "$failedsteproute" | grep -i 'CDIIS')" ] && [ -z "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(CDIIS\)\(.*\)!/Damp\2 !/ }' $icurinfile
            #9: FERMI again
            elif [ -n "$(echo "$failedsteproute" | grep -i '[(,]Damp')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/22=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\([,(]\)\(Damp\)\(.*\)!/\1Fermi\2 !/ }' $icurinfile
            #10: KyDiag
            elif [ -n "$(echo "$failedsteproute" | grep -i 'NDamp=75')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(SCF[^ ]*\)NDamp=[^,)]*/\1/I;s/(,/(/;s/,,/,/;s/,)/)/;s/\(.*\)!/\1 IOp(5\/16=2) !/ }' $icurinfile
            #11: Jacobi diagonalization (old, slow but robust)
            elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(5\/16=2)')" ] && ($banginghead); then
                wasiopscf="$(echo "$failedsteproute" | grep -o '.*[\!]*' | grep -o -e '[iI][oO]p[=(]*5\/16=[^ ]*' | xargs)"
                for hik in $wasiopscf; do sed -i '1,/Link1/{/#/s/'"${hik//\//\\/}"' \([^!]*\)!/\1! '"${hik//\//\\/}"' /}' $icurinfile; done
                sed -i '1,'"$endsolvhere"'{/#/s/\(.*\)!/\1 IOp(5\/16=10) !/ }' $icurinfile
            #12: Instead of everything else, using DM
            elif [ -n "$(echo "$failedsteproute" | grep -i -e 'YQC' -e 'DIIS')" ] && ($banginghead); then
                sed -i '1,'"$endsolvhere"'{/#/s/CDIIS/DM/I}' $icurinfile
            fi
        fi
        [ -n "$(sed -n '1,/--Link1/Ip' $icurinfile | grep '#' | grep -i 'SCF[=]*()')" ] && sed -i '1,'"$endsolvhere"'{/#/s/ SCF[=]*()//I}' $icurinfile
        sed -i '/#/{s/,,/,/g;s/,)/)/g;s/(,/(/g;s/),/)/g}' $icurinfile # I have no idea why the last case occurs
    fi
}

acc2esolver() {
    echo "Solving problems of integral accuracy..."
    curracc2e=$(grep -m 1 '#' $icurinfile | grep -o '[aA]cc2[eE]=[0-9]*')
    if [ -n "$curracc2e" ]; then
        case ${curracc2e:6} in # {0:0} to fool vi parser
            11) sed -i '1,/#/s/Acc2E=11/Acc2E=12/I' $icurinfile ;;
            12) sed -i '1,/#/s/Acc2E=12/Acc2E=13/I' $icurinfile ;;
            13) sed -i '1,/#/s/Acc2E=13/Acc2E=14/I' $icurinfile ;;
        esac
    else
        sed -i '1,/#/s/#[^ ]*/& Int=(Acc2E=11)/' $icurinfile # Increasing two-electron inegral accuracy may help
    fi
}

getgeomjob(){
            ramkudrov=$(tac "$1".out)
            otkudrov2="$1"
            njrk=$(echo "$ramkudrov" | grep -c 'Entering Link 1')
            ajrk="$njrk"
            njrk2=$njrk
            echo "$ramkudrov" | sed -n '1,/Entering Link 1/p' | tac > "$otkudrov2"_Otk0.out
            ramkudrov="$(echo "$ramkudrov" | sed '1,/Entering Link 1/d')" # we know that at least the last job does have the right structure
            while [ -n "$ramkudrov" ]; do
                nowkudrov="$(echo "$ramkudrov" | sed -n '1,/Entering Link 1/p' | tac)"
                ramkudrov="$(echo "$ramkudrov" | sed '1,/Entering Link 1/d')"
                atomlistr="$(echo "$nowkudrov" | sed -n '/Symbolic Z-matrix:\|Structure from the checkpoint file:/,/GradGradGradGradGradGradGradGrad/p' | sed '/coordinates found in file/d;/Charge =/d;/Symbolic Z-matrix/d;/GradGradGrad/d;/Recover connectivity data/d;/^\s*$/d' | cut -d ' ' -f 2 | cut -d ',' -f 1 | xargs)"
                geom_addinfo="$(echo "$nowkudrov" | sed -n '/Symbolic Z-matrix:\|Structure from the checkpoint file:/,/GradGradGradGradGradGradGradGrad/p' | sed '/coordinates found in file/d;/Charge =/d;/Symbolic Z-matrix/d;/GradGradGrad/d;/Recover connectivity data/d;/^\s*$/d')"
                if [ -n "$(echo "$geom_addinfo" | grep ',')" ]; then
                    geom_addinfo=$(while IFS=',' read el fixed x y z add; do echo "$fixed $add" | tr ',' ' '; done  <<< "$(echo "$geom_addinfo")")
                else
                    geom_addinfo="$(while read el x y z w add; do [ -n "$(echo "$x" | grep -o '^[0-9]\+$' | head -1)" ] && echo "$x $add" || echo "0 $w $add"; done  <<< "$(echo "$geom_addinfo")")"
                fi

                [ "$atomlistr" != "$atomlist" ] && break || njrk=$((njrk-1))
                [ -n "$(echo "$nowkudrov" | sed -n '1,/Entering Link 1/p' | grep ' Opt')" ] && ajrk="$ajrk $njrk" && echo "$nowkudrov" > "$otkudrov2"_Otk$((njrk2-njrk)).out
            done
            #echo "The following file is prepared: "
            #ls -l "$otkudrov2"_Otk0.out
            echo "Jobs usable for geometry are $ajrk ."
            echo "We prepared the following _Otk.out files:"
            echo "    (${otkudrov2}_Otk*)"
            ls "$otkudrov2"_Otk*
            export otkujob="$(echo "$ajrk" | tr ' ' '-')"
            export geom_addinfo
}

getprevgeom() {
            otkudrov2=${1%.out}; otkudrov3=""
            atomlist="$(tac "$1" | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Symbolic Z-matrix:\|Structure from the checkpoint file:/,/GradGradGradGradGradGradGradGrad/p' | sed '/coordinates found in file/d;/Charge =/d;/Symbolic Z-matrix/d;/GradGradGrad/d;/Recover connectivity data/d;/^\s*$/d' | cut -d ' ' -f 2 | cut -d ',' -f 1 | xargs)"
            export atomlist
            while [ "$otkudrov3" != "$otkudrov2" ]; do
                if [ -n "$otkudrov3" ]; then
                    triinfile=$(echo "$otkudrov2" | sed 's/\(_[0-9G]\+\)*.out//' )
                    nowlutil_nr2=${triinfile##*_U}
                    [ $nowlutil_nr2 -gt 1 ] && otkudrov2="${triinfile%_U*}_U$((nowlutil_nr2-1)).gjf" || echo "Cannot move up the file list -- the top is reached!"
                fi
                otkudrov3=$otkudrov2
                while [ "$otkudrov2" != "$(echo ${otkudrov2} | sed 's/_[0-9]\+$//')" ]; do
                    otkudrov2=$(echo ${otkudrov2} | sed 's/_[0-9]\+$//')
                    [ ! -f "${otkudrov2}.out" ] && echo "${otkudrov2}.out not found..." && continue
                    atomlist2="$(tac "$otkudrov2".out | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Symbolic Z-matrix:\|Structure from the checkpoint file:/,/GradGradGradGradGradGradGradGrad/p' | sed '/coordinates found in file/d;/Charge =/d;/Symbolic Z-matrix/d;/GradGradGrad/d;/Recover connectivity data/d;/^\s*$/d' | cut -d ' ' -f 2 | cut -d ',' -f 1 | xargs)"
                    [ "$atomlist2" != "$atomlist" ] && echo "Cannot go backwards in file list, structure changed!" || otkudrov3="$otkudrov2"
                    break
                    #[ -n "$(tac "$otkudrov2" | sed -n '1,/Entering Link 1/p' | grep -e 'Symbolic Z-matrix:' "$otkudrov2")" ] && break
                done
            done
            [ "${2%.out}" == "$otkudrov2" ] && echo "No previous geometries available!"
            getgeomjob "$otkudrov2"
            export otkudrov=${otkudrov2}.out # if this == $2, the code calling this fxn will detect it could not find any new geom
            export otkujob="$otkujob"
            [ -n "$3" ] && [ "$3" == "addinfo" ] && export geom_addinfo
}

geomfromdone() { # actually inserts the geometry from a preselected job in preselected file
    icurinfile=$1 # gjf file to modify
    otkudrov=$2 # out file to seek for the geometry
    njobbs=$3 # Number of normally terminated jobs
    njobbs2=$4 # Sequential number of the most suitable job
    beststep=$5 # "best" step deduced by some external code
    debugging=$6 # whether to flood the log file
    [ -f tmp.geomfile.foo.$HOSTNAME ] && rm tmp.geomfile.foo.$HOSTNAME; touch tmp.geomfile.foo.$HOSTNAME
    dos2unix "$icurinfile"
    if [ "$otkudrov" != "${otkudrov%.xyz}" ]; then
        ($debugging) && echo "DEBUG: Using the shifted geometry as the new one..."
        bestgeom="${otkudrov%.xyz}.gem"
        mv "$otkudrov" "${otkudrov%.xyz}.gem"
        otkudrov="${otkudrov%.xyz}.gem"
        sed -i '1,2d' "$otkudrov"
        >> "$otkudrov"
        [ -z "$(sed -n '1,/--Link1--/I{/#/p}' $icurinfile | grep -i 'IOp(1/11=2)')" ] && sed -i '1,/--Link1--/I{/#/s/[^!]*/& IOp(1\/11=2)/}' $icurinfile
        ##### sed -i '1,/--Link1--/I{s/CalcAll/&,MaxCycles='"$calcfcevery"',MaxStep=1/I;}' $icurinfile # shall be lifted in tmp2; this allows to make the Stable=Opt guess
    else
        ($debugging) && echo "DEBUG: best step to use is $beststep within the output file $otkudrov"
        [ $njobbs2 -eq 1 ] && bestgeom_o=$(findmingeom -s $beststep $otkudrov 2>&1) || bestgeom_o=$(findmingeom -j $njobbs2 -s $beststep $otkudrov 2>&1)
        bestgeom=$(echo "$bestgeom_o" | grep -i "to Unix format[ ]*\.\.\." | xargs | cut -d ' ' -f 4) # sometimes Unix, sometimes UNIX; sometimes there is (?) a space and sometimes (definitely) not
        ($debugging) && echo -e "DEBUG: output of findmingeom is:\n$bestgeom_o"
        #($debugging) && echo "DEBUG: Contents of tmp file are:" && less tmp.geomfile.foo.$HOSTNAME
        sed -i '1,/--Link1--/I{/#/s/IOp(1\/11=2)//}' "$icurinfile" # because it tends to abort the job because of some tiny transrotary imaginary frequency; if we do not use a shifted geometry, it means we have no real saddle point and IOp(1\/11=2 is just giving us hiccups
    fi
    sed -n '1,/#/p' $icurinfile >> tmp.geomfile.foo.$HOSTNAME
    #($debugging) && echo "DEBUG: Contents of tmp file are:" && less tmp.geomfile.foo.$HOSTNAME
# This is done in two commands because it is impossible to reliably match the title or Ch/Mult line
    #sed -n '1,/--Link1--/I { /#/ {n; N; N; N; p} }' $icurinfile >> tmp.geomfile.foo.$HOSTNAME; >> tmp.geomfile.foo.$HOSTNAME
    #sed -i '1,/--Link1--/I{ s/ Geom[=(]*Check//I; s/CalcAll/CalcAll,MaxStep=1/I}' $icurinfile
    sed -n '1,/--Link1--/I { /#/ {:utka; n; p; /#/b utka; n; N; N; p} }' $icurinfile >> tmp.geomfile.foo.$HOSTNAME; >> tmp.geomfile.foo.$HOSTNAME
    sed -i 's/ Geom=Check//; s/ Guess[=(]\+\([^ ]*\)Read\([^ ]*\)/ Guess=(\1\2/g;s/ Guess=([)]*\( .*\)/\1/;s/ Guess=([)]*$//; s/,,/,/g;s/,)/)/g;s/(,/(/g' tmp.geomfile.foo.$HOSTNAME
    #($debugging) && echo "DEBUG: Contents of tmp file are:" && less tmp.geomfile.foo.$HOSTNAME
    # old way is: sed -n '1,/--Link1--/I { /#/ {n; N; N; N; p} }' $icurinfile >> tmp.geomfile.foo.$HOSTNAME; >> tmp.geomfile.foo.$HOSTNAME
    ($debugging) && echo "DEBUG: best geometry file is $bestgeom"
    cp tmp.geomfile.foo.$HOSTNAME tmp2.geomfile.foo.$HOSTNAME
    if [ -z "$(echo "$failedsteproute" | grep -i 'Geom[=(]*Check')" ] && [ $(wc -l < "$bestgeom") -lt 3 ] && [ -n "$(head -1 "$bestgeom" | grep AT)" ] && [ "$otkudrov" == "${otkudrov%.gem}" ]; then
        [ $njobbs2 -eq 1 ] && bestgeom=$(findmingeom -is $beststep $otkudrov 2>&1 | grep "to UNIX format \.\.\." | xargs -0 | cut -d ' ' -f 4) || bestgeom=$(findmingeom -ij $njobbs2 -s $beststep $otkudrov 2>&1 | grep "to UNIX format \.\.\." | xargs -0 | cut -d ' ' -f 4)
    fi
    prev_otkudrov="$otkudrov"; prev_otkujob="$otkujob"
    getprevgeom "$otkudrov" "haha" "addinfo"
    otkudrov="$prev_otkudrov"; otkujob="$prev_otkujob"

    if [ "$otkudrov" == "${otkudrov%.gem}" ] && { [ $(wc -l < "$bestgeom") -lt 2 ] || [ ! -f "$bestgeom" ]; }; then
        tac tmp.geomfile.foo.$HOSTNAME | sed '1,/Link1/{/#/s/#[^!]*/& Geom=(Check,Step='"$beststep"')/}' | tac > tmp.geomfile.foo.$HOSTNAME
    elif [ "$otkudrov" != "${otkudrov%.gem}" ] && { [ $(wc -l < "$bestgeom") -lt 3 ] || [ ! -f "$bestgeom" ]; }; then
        echo "Could not read the new geometry!"
        return 7
    else
        elements_geom=$(cat "$bestgeom" | gawk '{print $1}')
        xyzxyzxyz_geom=$(cat "$bestgeom" | gawk '{print $2, $3, $4}')
        freezecode_geom=$(echo "$geom_addinfo" | gawk '{print $1}')
        addinfo_geom=$(echo "$geom_addinfo" | gawk '{for (i=2; i <= NF; i++) printf (i==2? "%s":" %s"),$i; print ""}')
        if [ -n "$(echo "$freezecode_geom" | grep -e '-1')" ]; then
            paste <(echo "$elements_geom") <(echo "$freezecode_geom") <(echo "$xyzxyzxyz_geom") <(echo "$addinfo_geom") >> tmp.geomfile.foo.$HOSTNAME
        else
            paste <(echo "$elements_geom") <(echo "$xyzxyzxyz_geom") <(echo "$addinfo_geom") >> tmp.geomfile.foo.$HOSTNAME
        fi
        [ "$otkudrov" != "${otkudrov%.gem}" ] && echo "" >> tmp.geomfile.foo.$HOSTNAME
    fi
    #    ($debugging) && echo "DEBUG: Contents of tmp file are:" && less tmp.geomfile.foo.$HOSTNAME
    unset bestgeom
#                      b=blank line, c=charge and m-city: b;t;b;c;     geom is skipped                        ; and the rest of the file printed
    ($debugging) && echo "DEBUG: Contents of tmp file are:" && { cat tmp.geomfile.foo.$HOSTNAME | sed 's/^/--> /'; }
    ($debugging) && echo "DEBUG: We are going to add this:" && sed -n '1,/--Link1--/Ip' "$icurinfile" | sed -n '/#/ {:putka; n; /#/b putka;n;N;N;:utka n; s/\t/ /;/^[ ]*[A-Z][a-z]\?\([ ]\+[-]*[0-9]\+\.[0-9]\+\)\{3\}/b utka; :shutka p; n; /--Link1--/I!b shutka }'
    sed -n '1,/--Link1--/Ip' "$icurinfile" | sed -n '/#/ {:putka; n; /#/b putka;n;N;N;:utka n; s/\t/ /;/^[ ]*[A-Z][a-z]\?\([ ]\+[-]*[0-9]\+\.[0-9]\+\)\{3\}/b utka; :shutka p; n; /--Link1--/I!b shutka }' | tee -a tmp.geomfile.foo.$HOSTNAME  >> tmp2.geomfile.foo.$HOSTNAME
    nextgarbgff=$(echo "$icurinfile" | sed 's/\(_[0-9G]\+\)*.gjf//' )
    nowglutil_to=${nextgarbgff##*_U}
    nextgarbgff="${nextgarbgff%_U*}_U$((nowglutil_to+1)).gjf"
    garbg=""; garbgf=$(cat "$icurinfile")
    for xhg in {1..3}; do
        garbgf=$(echo "$garbgf" | sed '1,/--Link1--/Id')
        [ -z "$(echo "$garbgf" | sed '/^\s*$/d')" ] && garbgf="$nextgarbgff"
        garbg=$(echo "$garbg"; echo "$garbgf" | sed -n '1,/--Link1--/Ip')
    done
    #echo >> tmp.geomfile.foo.$HOSTNAME
    if [ -z "$(echo "$garbg" | grep -i 'stable=opt')" ] || [ -z "$(echo "$garbg" | grep -i 'calcall')" ]; then
        echo "--Link1--"  >> tmp.geomfile.foo.$HOSTNAME
        ($debugging) && echo "DEBUG: Contents of tmp file are:" && { cat tmp.geomfile.foo.$HOSTNAME | sed 's/^/--> /'; }
        cat tmp2.geomfile.foo.$HOSTNAME | sed '/#/{s/ Guess[=(][^ ]*//;s/^[^!]*/& Geom=Check Guess=Read/;s/MaxCycles=5//;s/ Opt[=(]*[^ ]*/ Stable=Opt/}' >> tmp.geomfile.foo.$HOSTNAME
        sed -i '/ Stable=Opt/,${/Now the test for imaginary frequencies/d}' tmp.geomfile.foo.$HOSTNAME
        echo "--Link1--"  >> tmp.geomfile.foo.$HOSTNAME
        echo >> tmp.geomfile.foo.$HOSTNAME
        sed -i '/Now the test for imaginary frequencies/{x;s/.*//;x;N;/^$/d}' "tmp.geomfile.foo.$HOSTNAME"
        # the reason I am still adding CalcAll even if the failed job already had CalcAll is because of Stable=Opt job in between them
        cat tmp2.geomfile.foo.$HOSTNAME | sed '/#/{s/ Guess[=(][^ ]*//Ig;s/ Geom=Check//Ig;s/^[^!]*/& Geom=Check Guess=Read/;s/CalcFC//Ig;s/ReadFC//Ig;s/CalcAll//Ig;s/ Opt[=(]*\([^ !]*\)/ Opt=(CalcAll,\1)/;s/MaxCycles=[0-9]\+//Ig;s/,,/,/g;s/,)/)/g;s/(,/(/g;s/),/,/g;s/))/)/g}' >> tmp.geomfile.foo.$HOSTNAME
        #echo  >> tmp.geomfile.foo.$HOSTNAME
    fi
    unset garbg garbgf
    sed -n '/--Link1--/I,$p' "$icurinfile"  >> tmp.geomfile.foo.$HOSTNAME
    #sed -n '1,/--Link1--/I { /#/ {N;N;N;N;:utka n; s/\t/ /;/^[ ]*[A-Z][a-z]*[ ]*/b utka; p; n; :shutka p; n; b shutka } }' $icurinfile  >> tmp.geomfile.foo.$HOSTNAME
    #sed '1,/--Link1--/Id' $icurinfile  >> tmp.geomfile.foo
    ($debugging) && echo "DEBUG: Contents of tmp file are:" && { cat tmp.geomfile.foo.$HOSTNAME | sed 's/^/--> /'; }
    rm $icurinfile; mv tmp.geomfile.foo.$HOSTNAME $icurinfile
    rm tmp2.geomfile.foo.$HOSTNAME
    export icurinfile beststep otkudrov otkudrov2
}

geomsolver() { # TODO: taking geometry off the saddle point by using forces and force constants found in the out file
# also TODO: finding the direction in which oscillations proceed and distorting the molecule to take it off the saddle point
    njobbs=$(grep -c 'Normal termination' $2)
    njobbs2=$(grep -c 'Entering Link 1' $2)
    solvegeom=$3
    otkudrov="$2"
    export atomlist="$(tac "$2" | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Symbolic Z-matrix:\|Structure from the checkpoint file:/,/GradGradGradGradGradGradGradGrad/p' | sed '/coordinates found in file/d;/Charge =/d;/Symbolic Z-matrix/d;/GradGradGrad/d;/Recover connectivity data/d;/^\s*$/d' | cut -d ' ' -f 2 | cut -d ',' -f 1 | xargs)"
    getgeomjob "${2%.out}"
    allkudrovsss=()
    if [ -f "$(echo ${otkudrov%.out}_Otk*out | cut -d ' ' -f 1)" ]; then
        if ( $debugging ); then
            echo "DEBUG: now we have the following temp files:"
            ls ${otkudrov%.out}_Otk*out
            echo "==tf==tf==tf==tf==tf==tf==tf==tf==tf==tf=="
        fi
        allkudrovsss=($(ls ${otkudrov%.out}_Otk*out))
        if [ ${#allkudrovsss[@]} -gt 0 ]; then
            findminstep_o=$(findminstep -j 1 $(ls -v ${otkudrov%.out}_Otk*out))
        else
            beststep=$(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 4)
        fi
        if ( $debugging ); then
            echo "DEBUG: the output of findminstep is:"
            echo "$findminstep_o"
            echo "+++++++=======+++++++=======+++++++"
        fi
        beststep=$(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 6)
        bestjob=$(($(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 10)-1))
        bestjobf="${allkudrovsss[$bestjob]}"
    else
        #echo "DEBUG: now we have no temp files!"
        bestjobf="$2"
        findminstep_o=$(findminstep -j $njobbs "$2")
        beststep=$(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 4)
    fi
    # Aulde Schoole waye: [ $njobbs2 -eq 1 ] && beststep=$(findminstep $2 | tac | grep -m 1 "Recommended step is" | cut -d ' ' -f 4) || beststep=$(echo -e "$njobbs2\n" | findminstep $2 | tac | grep -m 1 "Recommended step is" | cut -d ' ' -f 4)
    [ -z "$beststep" ] && beststep=0
    echo "Best step of previous job was $beststep."
    oldkudrov="$otkudrov"
    while [ ${beststep%.} -le 1 ]; do
        ($debugging) && echo "DEBUG: trying to find some previous file with a suitable geometry..."
        dorfo=false
        cannotzero $otkudrov # this allows to add guesses, etc. between preliminary and final optimization
        getprevgeom "$otkudrov"
        allkudrovsss=()
        ($debugging) && echo -n "DEBUG: seems the best we can get right now is the file $otkudrov, "
        if [ -f "$otkudrov" ] || [ -f "$(echo ${otkudrov%.out}_Otk*out | cut -d ' ' -f 1)" ]; then
            if ($debugging); then
                echo "DEBUG: now we have the following temp files:"
                ls ${otkudrov%.out}_Otk*out
            fi
            [ -f "$otkudrov" ] && otkudrovx="$otkudrov" || otkudrovx="$(echo ${otkudrov%.out}_Otk*out | cut -d ' ' -f 1)"
            njobbs=$(grep -c 'Normal termination' $otkudrovx)
            njobbs2=$(grep -c 'Entering Link 1' $otkudrovx)
            ($debugging) && echo "which contains $njobbs successful jobs."
            allkudrovsss=($(ls ${otkudrov%.out}_Otk*out 2>/dev/null))
            findminstep_o=$(findminstep -j 1 $(ls -v ${otkudrov%.out}_Otk*out))
            if ($debugging); then
                echo "DEBUG: the output of findminstep is:"
                echo "$findminstep_o"
                echo "+++++++=======+++++++=======+++++++"
            fi
            beststep=0; bestjob=1
            beststep=$(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 6)
            bestjob=$(($(echo "$findminstep_o" | grep "Recommended step is" | tail -1 | cut -d ' ' -f 10)-1))
            bestjobf="${allkudrovsss[$bestjob]}"
            [ -z "$bestjobf" ] && bestjobf="$otkudrovx"
        else
            ($debugging) && echo "which for some reason does not exist. Well done, sir." && break
        fi
        [ "$otkudrov" == "$oldkudrov" ] && break
        oldkudrov="$otkudrov"
    done # if there was no best step in the last job
    if [ ${#allkudrovsss[@]} -gt 0 ]; then
        if ($debugging); then
            echo "gg.gg.gg. Starting geomfromdone to get the right geometry for the new input..."
            [ -z "$icurinfile" ] && echo "No input file! Geometry solving impossible."
            [ -z "$bestjobf" ] && bestjobf="$otkudrov" && echo "No output file! Subst. with the last output file."
            { [ -z "$beststep" ] || [ $beststep -eq 0 ]; } && beststep=$(tac "$bestjobf" | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') && echo "No best step known! Will use the last one."
        fi
        geomfromdone $icurinfile "$bestjobf" 1 $(grep -c 'Normal term' "$bestjobf") $beststep $debugging
        ($debugging) && echo "gg.gg.gg. Terminated geomfromdone."
        rm ${firstcurinfile%.gjf}*_Otk[0-9]*out
    fi
    ($debugging) && echo "-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->" &&  echo "DEBUG: Contents of the new input file after replacing the geometry by geomsolver are:" && { cat $icurinfile | sed 's/^/---> /'; echo "-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->"; }
    if [ $solvegeom -gt 4 ]; then
        [ -n "$(echo "$failedsteproute" | grep -i ' Opt ')" ] && sed -i '1,/#/s/ Opt / Opt=() /I' $icurinfile || { [ -z "$(echo "$failedsteproute" | grep -i ' Opt[=]*(')" ] && sed -i '1,/#/s/ Opt=\([^ ]*\)/ Opt=(\1)/I' $icurinfile; } # gives every Opt keyword =()
        failedsteproute=$(ifind $icurinfile "#")
        if [ -z "$(echo "$failedsteproute" | grep -i -e 'scipcm' -e 'LC-wPBE' -e 'HSE' -e 'PBEh' -e 'PKZB')" ] && [ -z "$(echo "$failedsteproute" | grep -o ' [oO]pt[^ ]\+' | grep -i -e 'CalcAll' -e 'CalcFC[^ ]*MaxCycles=')" ]; then
            [ -z "$calcfcevery" ] && calcfcevery=20
            sed -i '1,/--Link1--/I{/#/s/CalcAll/CalcFC,MaxCycles='"$calcfcevery"',MaxStep=1/I;}' $icurinfile
            [ -z "$(sed -n '1,/--Link1--/I{/#/p}' "$icurinfile" | grep 'CalcFC,MaxCycles=')" ] && sed -i '1,/--Link1--/I{/#/s/ Opt[(=]*/&=(CalcFC,MaxCycles='"$calcfcevery"',MaxStep=1,/I;/#/s/ Opt[=(]\+/ Opt=(/g;s/, / /g}' $icurinfile
            if [ -n "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep lutil)" ]; then
                nnnlutil=$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -n lutil | cut -d : -f 1)
            else
                nnnlutil=$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -ni '\-\-Link1' | cut -d : -f 1)
            fi
            if [ -z "$nnnlutil" ]; then
                echo "ERROR: do not know where to insert the iterlutil!!!!"
            else
                sed -i ${nnnlutil}"i !lutil iterlutil anfreqevery" "$icurinfile"
            fi
        elif [ -z "$(echo "$failedsteproute" | grep -i -e 'scipcm' -e 'LC-wPBE' -e 'HSE' -e 'PBEh' -e 'PKZB')" ] && [ -z "$(echo "$failedsteproute" | grep -o ' [oO]pt[^ ]*' | grep -i 'CalcAll')" ]; then
            sed -i '1,/--Link1--/I{/#/s/CalcFC/CalcAll/I;/iterlutil anfreqevery/d}' "$icurinfile"
        elif [ -n "$(echo "$failedsteproute" | sed -n 's/\!.*//' | grep -o ' [oO]pt[^ ]*\( Freq[^ !]*\)*' | grep -ie 'Calc' -e 'Freq')" ] && [ -n "$(grep 'No analytic 2nd derivatives for this method' $2)" ]; then
            sed -i '1,/--Link1--/I{/#/{s/CalcFC//I;s/ Freq[^ !]*//I;s/CalcAll//I;s/,)/)/;s/(,/(/;s/,,/,/;s/.*/& ! Opt=CalcFC/;:a;n;ba}}' $icurinfile
            sed -i '1,/--Link1--/I{s/Opt[=]*(/Opt=(MaxStep=1,RFO,/I;/iterlutil anfreqevery/d};s/,)/)/' $icurinfile
        # the next solutions correspond to Opt=CalcFC/CalcAll case (or when it is impossible to Calc)
        elif [ -z "$(echo "$failedsteproute" | grep -i 'RFO')" ] && [ -z "$(echo "$failedsteproute" | grep -i 'Cartesian')" ];then # default was GEDIIS
            sed -i '1,/--Link1--/I{/#/s/Opt[=]*(/Opt=(MaxStep=1,RFO,/I;/iterlutil anfreqevery/d};s/,)/)/' $icurinfile
        elif [ -z "$(echo "$failedsteproute" | grep -i 'Cartesian')" ];then
            sed -i '1,/#/s/NoRaman/&,Cartesian/I' $icurinfile
        elif [ -n "$(echo "$failedsteproute" | grep -i 'RFO')" ];then # back to the default GEDIIS but Cartesian
            sed -i '1,/--Link1--/I{/#/s/Opt[=]*(/Opt=(MaxStep=1,RFO,/I;s/,)/)/}' $icurinfile
        elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(1/19')" ];then
            sed -i '1,/--Link1--/I{/#/{s/ IOp(1\/10=9)//I;s/#[^!]*/& IOp(1\/19=10) !IOp(1\/10=9)/I;:a;n;ba}}' $icurinfile # GDIIS+linear
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/19=10)')" ];then
            sed -i '1,/--Link1--/I{/#/{s/IOp(1\/19=10)/IOp(1\/19=8)/I;s/.*/& !IOp(1\/19=10)/;:a;n;ba}}' $icurinfile # NR+linear
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/19=8)')" ];then
            sed -i '1,/--Link1--/I{/#/{s/IOp(1\/19=8)/IOp(1\/19=3)/I;s/#[^!]*/& !IOp(1\/19=8)/;:a;n;ba}}' $icurinfile # SD+linear
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/13')" ];then
            sed -i '1,/--Link1--/I{/#/{s/\(IOp(1\/19=[^)]*)\)\(.*\)/\2 ! \1/I;s/#[^!]*/& IOp(1\/13=7)/;:a;n;ba}}' $icurinfile
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/13=7)')" ];then
            sed -i '1,/--Link1--/I{/#/{s/IOp(1\/13=7)/IOp(1\/13=5)/I;s/#[^!]*/& !IOp(1\/13=7)/;:a;n;ba}}' $icurinfile
        # Nota bene: IOp(1\/10=9) does not work for L103 (Berny)
        elif [ -z "$(echo "$failedsteproute" | grep -i 'IOp(1/10=9')" ] && [ -n "$(echo "$failedsteproute" | grep -i 'CalcAll')" ];then
            sed -i '1,/--Link1--/I{/#/{s/,RFO//I;s/#[^!]*/& IOp(1\/10=9)/I;:a;n;ba}}' $icurinfile # GenFC from MM
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/13=5)')" ] && [ -n "$(echo "$failedsteproute" | grep -i 'CalcAll')" ];then # does not work for L103 (Berny)
            sed -i '1,/--Link1--/I{/#/{s/IOp(1\/13=5)/IOp(1\/13=3)/I;s/#[^!]*/& !IOp(1\/13=5)/;:a;n;ba}}' $icurinfile
        elif [ -n "$(echo "$failedsteproute" | grep -i 'IOp(1/13=3)')" ] && [ -n "$(echo "$failedsteproute" | grep -i 'CalcAll')" ];then # does not work for L103 (Berny)
            sed -i '1,/--Link1--/I{/#/{s/IOp(1\/13=3)/IOp(1\/13=1)/I;s/#[^!]*/& !IOp(1\/13=3)/;:a;n;ba}}' $icurinfile
        fi
    fi
    [ $solvegeom -gt 4 ] && echo "Using last good geometry found, possibly with amendments in the Route line..." || echo "Using last good geometry found, without changing the Route line..."
    sed -i '/#/{s/,,/,/g;s/,)/)/g;s/(,/(/g}' $icurinfile
    ($debugging) && echo "-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->" && echo "DEBUG: Contents of the new input file ($icurinfile) at the end of geomsolver are:" && { cat $icurinfile | sed 's/^/w--> /'; echo "-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->"; echo "Contents of the next input file are:" && cat $(ls -v ${firstcurinfile%.gjf}*gjf | tail -1) | sed -n '1,/^#.* [Oo]pt/p' | sed 's/^/x--> /'; }
}

rwfsolver() {
    diskspace $icurinfile
    rwfwork=$(wc -c < $GAUSS_SCRDIR/*.rwf)
    intwork=$(wc -c < $GAUSS_SCRDIR/*.int)
    rwfpub=$(wc -c < $GAUSS_SPRSCRDIR/*.rwf)
    intpub=$(wc -c < $GAUSS_SPRSCRDIR/*.int)

    presentdiskinfo="$(rwf2gjf -bd $icurinfile)"
    isworkrwf=$(echo "$presentdiskinfo" | cut -d ' ' -f 1)
    isworkint=$(echo "$presentdiskinfo" | cut -d ' ' -f 2)
    isworkrwf=${isworkrwf/GB/}; isworkint=${isworkint/GB/}
    wasall=$((isworkrwf+isworkint+3))
    intrwfwork=$((100*(isworkint-1)/wasall))

    presentdiskinfo2="$(rwf2gjf -bd ${icurinfile/_1//})"
    isworkrwf2=$(echo "$presentdiskinfo2" | cut -d ' ' -f 1)
    isworkint2=$(echo "$presentdiskinfo2" | cut -d ' ' -f 2)
    isworkrwf2=${isworkrwf2/GB/}; isworkint2=${isworkint2/GB/}
    wasall2=$((isworkrwf2+isworkint2+3))
    intrwfwork2=$((100*(isworkint2-1)/wasall2))

    presentdiskinfo3="$(rwf2gjf -bd ${icurinfile/_1_1//})"
    isworkrwf3=$(echo "$presentdiskinfo3" | cut -d ' ' -f 1)
    isworkint3=$(echo "$presentdiskinfo3" | cut -d ' ' -f 2)
    isworkrwf3=${isworkrwf3/GB/}; isworkint3=${isworkint3/GB/}
    wasall3=$((isworkrwf3+isworkint3+3))
    intrwfwork3=$((100*(isworkint3-1)/wasall3))

    [ $(((intrwfwork-intrwfwork2)*(intrwfwork2-intrwfwork3))) -gt 0 ] && rwfdkoef=10 || rwfdkoef=1
    ( $regclean ) && getridofdirt $firstcurinfile
    cp $icurinfile $icurinfile.bup
    if [ $intwork -gt $rwfwork ] || [ $intpub -gt $rwfpub ]; then
        rwf2gjf -i $(((intrwfwork-1)*rwfdkoef)) $icurinfile
    else
        rwf2gjf -i $(((intrwfwork+1)*rwfdkoef)) $icurinfile
    fi
    echo "Restarting with redistributed disk space..."
    if [ -z "$(diff $icurinfile $icurinfile.bup)" ]; then
        ($debugging) && echo "DEBUG: Solving RWF, writing ${firstcurinfile%.gjf}_failed.gjf..."
        [ -z "$(tail -7 ${firstcurinfile%.gjf}_failed.gjf | grep -i '\-\-Link1\-\-')" ] && echo -en "\n--Link1--\n\n" >> ${firstcurinfile%.gjf}_failed.gjf
        echo '!the following comes from: '"$curinfile" >> ${firstcurinfile%.gjf}_failed.gjf
        deathrow="$(sed -n '1,/--Link1--/Ip' $icurinfile | tee -a ${firstcurinfile%.gjf}_failed.gjf)" # added since v. 0.4.0.9
        if [ -n "$(tac "$2" | sed -n '1,/Entering Link 1/p' | grep 'Structure from the checkpoint file')" ]; then
            errstruct="$(tac "$2" | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Structure from the checkpoint file/,/Recover connectivity data from disk./p' | sed '1,3d' | sed 's/,0,-/  -/;s/,0,/   /;s/,-/  -/g;s/,/   /g;$d' | sed 's/\r//;s/$/\\/')"
            erstrln=$(grep -n '^[ ]*#' ${firstcurinfile%.gjf}_failed.gjf | tail -1 | cut -d ':' -f 1) # thanks terdon unix.stackexchange.com/questions/112159
            erstrln=$((erstrln+4))
            sed -i "$erstrln"' a'"$errstruct" "${firstcurinfile%.gjf}_failed.gjf"
            sed -i 's/\\$//' "${firstcurinfile%.gjf}_failed.gjf"
            sed -i "$erstrln"' s/.*/& /;s/ Geom[=(]*Check[)]*//I;s/\(Guess[^ ]*\)\(Read\)/\1/I;s/,)/)/;s/(,/(/;s/()//;s/ Guess[=()]* / /' "${firstcurinfile%.gjf}_failed.gjf"
        fi
        ($debugging) && echo "DEBUG: Icurinfile is $icurinfile, while the first argument is $1"
        if [ -n "$(echo "$deathrow" | grep '^[[:space:]]*!lutil')" ]; then
            sed -n '/\!lutil/,$p' -i $icurinfile # it means that utilities after the failed job will be executed (?)
        else
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        fi
        until [ -n "$(head -n 1 $icurinfile | grep '%')" ] || [ $(wc -c $icurinfile | cut -f 1 -d ' ') -lt 20 ]; do
            sed '1 d' -i $icurinfile 
        done
        sleep 10; echo "Out of space (moving on) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        echo "Disk space redistribution not beneficial, dropping the task..."
    else
        echo "Out of space (restarting) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
    fi
}

generscpcmgjf() { # function generates fallback input file for the SC-PCM jobs, containing the NonEq=Write and current job
# First, the NonEq=Read job and all the consequent jobs are read and stored in ramfile2 variable
    icurinfile2=${1%.gjf}_fbk.gjf
    cp $1 $icurinfile2 # at this moment, the file appears on the disk
    echo "Preparing fallback input file with name $icurinfile2..."
    ramfile2=$(cat $icurinfile2)
# Now will search for the NonEq=Write job...
    icurinfile3=$1
    gotgeometry=1
    ifoundgeom=""
    while [ -z "$(sed -n "$gotgeometry"',$p' "$icurinfile3" | grep -i 'NonEq=Write')" ]; do
        [ -n "$ifoundgeom" ] && echo "Cannot prepare fallback file -- no NonEq=Write job found (case1)!" && return 3
        oldicurinfile3="$icurinfile3"
        if [ -z "$(echo "${icurinfile3##*_U}" | sed 's/[0-9]\+\.gjf//')" ]; then # then it does end with "_Unn.gjf"
            unumtagad=$(echo "${icurinfile3##*_U}" | sed 's/\.gjf//')
            if [ $unumtagad -gt 1 ]; then
                unumtagad=$((unumtagad-1))
                icurinfile3=$(ls ${icurinfile3%_U*}_U${unumtagad}*gjf | head -1)
            fi
        else
            icurinfile3="${icurinfile3%_[0-9]*}.gjf"
        fi
        [ "$icurinfile3" == "$oldicurinfile3" ] && echo "Cannot prepare fallback file -- no NonEq=Write job found (case 2)!" && return 2
        ifoundgeom=$(sed -n '/^#/{:a;n;n;n;n;n;p}' "$icurinfile3" | grep -v '^\s*$' | tail -1) # first line of the last one among explicitly specified geometries (if present; otherwise, empty line)
        [ -n "$ifoundgeom" ] && gotgeometry=$(grep -n "$ifoundgeom" "$icurinfile3" | cut -d ':' -f 1) || gotgeometry=1
    done
    #ramfile=""
    #($debugging) && echo "DEBUG: ramfile2 intial size is $(wc -c <<< "$ramfile2")"
    #if [ "$icurinfile2" == "$icurinfile3" ]; then
    #    for kdgs in $(seq $nrdone); do # I need the ramfile2 to contain all the next jobs while ramfile will contain the NonEq=Write plus all that will be deleted next
    #        ramfile=$(echo -e "$ramfile\n$(echo "$ramfile2" | sed -n '1,/--Link1--/Ip')")
    #        ramfile2=$(echo "$ramfile2" | sed '1,/--Link1--/Id') # deletes everything until first "--Link1--", including that line
    #    done
    #else
    #    for kdgs in $(seq $nrdone); do
    #        ramfile2=$(echo "$ramfile2" | sed '1,/--Link1--/Id') # deletes everything until first "--Link1--", including that line
    #    done
    #    ramfile=$(cat $icurinfile3)
    #fi
    #($debugging) && echo "DEBUG: after removing succ. jobs ramfile2 size is $(wc -c <<< "$ramfile2")"
    #($debugging) && echo "DEBUG: after removing succ. jobs ramfile size is $(wc -c <<< "$ramfile")"
    #until [ -n "$(echo "$ramfile2" | head -n 1 | grep %)" ] || [ -z "$ramfile2" ]; do
    #    ramfile2=$(echo "$ramfile2" | sed '1 d')
    #done
# Now the NonEq=Write job will be written to variable ramfile and all the other jobs will be eliminated from the contents of this variable
    ramfile=$(cat $icurinfile3)
    ramfile=$(echo "$ramfile" | tac)
    while [ -z "$(echo "$ramfile" | sed -n '1,/--Link1--/Ip' | grep -i 'NonEq=Write')" ]; do
        ramfile=$(echo "$ramfile" | sed '1,/--Link1--/Id')
    done # after this step, there is NO --Link1-- after NonEq=Write job
    ($debugging) && echo "DEBUG: Probably the NonEq=write job is found; size of ramfile is $(wc -c <<< "$ramfile")"
    ramfile=$(echo "$ramfile" | sed -n '1,/--Link1--/Ip' | tac) # now contains the job with NonEq=Write BEFORE which there is --Link1--
    ($debugging) && echo "DEBUG: Now it contains just that job; size of ramfile is $(wc -c <<< "$ramfile")"
    until [ -n "$(echo "$ramfile" | head -n 1 | grep %)" ] || [ -z "$ramfile" ]; do
        ramfile=$(echo "$ramfile" | sed '1 d')
    done # and now it does not have any --Link1-- altogether
    ramfile=$(echo "$ramfile" | sed '1,/--Link1--/I{/#/{s/\( Guess[^ ]*\)\(Read\|TCheck\)\([^ ]*\)/\1\3/I;s/,,/,/g;s/(,/(/g;s/,)/)/g;s/()//g;s/ Guess[=]*\( \|$\)//}}')
    ramfile=$(echo -e "$ramfile\n\n--Link1--\n") # must have that --Link1-- here after all -- now its non-redunduncy should be guaranteed by reading the NEWLY-MADE job to ramfile2 (instead of generating it once more...)
    ($debugging) && echo "DEBUG: Removed Read/TCheck options for Guess, did not add trailing Link1; size of ramfile is $(wc -c <<< "$ramfile")"

    if [ -n "$(echo "ramfile2" | sed -n '1,/--Link1--/I{/^#/p}' | grep -i 'scrf[^ ]*restart')" ]; then
        if [ -z "$(echo "ramfile2" | sed -n '1,/--Link1--/Ip' | grep -i '^%OldChk=')" ]; then
            activeoldchkf=$(echo "ramfile" | grep -i '^%Chk=' | cut -d '=' -f 2)
            ramfile2=$(echo "ramfile2" | sed '1,/^%Chk=/Ii%OldChk='"$activeoldchkf")
        else
            echo "Impossible things are happening (file with scrf=restart contains oldchk Link0 command)..."
            sed '1,/--Link1--/I{s/^\(%OldChk=\).*$/\1'"$activeoldchkf"'/I}' "$icurinfile"
        fi
        ramfile2=$(echo "ramfile2" | sed '1,/--Link1--/I{/#/{s/\(scrf[^ ]*\)restart/\1/I;s/,,/,/g;s/(,/(/g;s/,)/)/g;}}')
        echo "Cancelled restarting SCRF within the fallback file..."
    fi
    echo "$ramfile" > $icurinfile2
    echo >> $icurinfile2
    echo "$ramfile2" >> $icurinfile2
    unset ramfile ramfile2
    ($debugging) && echo "about to return the file..."
    newfallbackname="$icurinfile2"
    export newfallbackname
    return 0
}

scpcmsolver() {
#    nrdone=$(grep -ce "Normal term" $2); #((totlines--))
#    icurinfile=${1%.gjf}_$((nrdone+1)).gjf
#    cp $1 "$icurinfile"
    ($debugging) && echo "Currently icurinfile is $icurinfile, and nrdone is $nrdone"
    if [ $(wc -l < $icurinfile) -ge 2 ]; then
        if [ -z "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i 'scrf[=(]*[^)]*Read')" ]; then # ?!
            ($debugging) && echo "There was no SCR=Read option (?!), adding it..."
            koaizv="$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i 'scrf[=(]*[^)]*solvent=[^)]*,')"
            sed -i '1,/--Link1--/Is/'"$koaizv"'/'"$koaizv"'Read,/I' "$icurinfile"
        fi
        if [ -n "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i 'noneq')" ]; then
            ($debugging) && echo "Found the NonEq section within the job which will be modified..."
            koaizv="$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i -e 'noneq=[^\s]*' -e 'maxextit=[0-9]\+')"
            if [ -n "$(echo "$koaizv" | grep 'MaxExtIt=150')" ] && [ -z "$(echo "$koaizv" | grep 'MaxExtIt=250')" ]; then
                if [ -z "$(echo "$koaizv" | grep 'MaxExtIt=250')" ]; then
                    sed -i '1,/--Link1--/Is/MaxExtIt=150/MaxExtIt=250/I' "$icurinfile"
                fi
            elif [ -n "$(echo "$koaizv" | grep 'MaxExtIt=250')" ]; then
                echo "No known way to solve the SC-PCM issue..."
            else
                sed -i '1,/--Link1--/Is/'"$koaizv"'/'"$koaizv"'\nMaxExtIt=150/I' "$icurinfile"
            fi
        else # may also contain Connectivity, AIMD, ReadIsotopes and charge, but for now not relevant to me
            if [ -n "$(sed -n '1,/--Link1--/I{/^#/p}' "$icurinfile" | grep -i -e ' charge' -e 'geom[^ ]*connect' -e 'ADMP' -e 'BOMD' -e 'readisotope')" ]; then
                echo "Adding new additional input section after other additional input sections is not yet implemented, unfortunately."
            else
                ($debugging) && echo "Added the NonEq section to the job which will be modified..."
                sed -i '1,/--Link1--/I{/#/{N;N;N;:a;N;/^$/!ba;s/$/\nNonEq=Read MaxExtIt=150\n/}}' "$icurinfile"
                #sed -i '1,/--Link1--/I{s/Guess[(=]*[^ ]*/Guess=Read/I;/OldChk/Id;s/\(%Chk=\)\([^ ]*\)/%OldChk=\2\n\1\2/I;/%Chk=/s/.chk/_anew.chk/I;}' "$icurinfile" # this is the old and not-working way of restarting SCRF=SC-PCM, but D. Fox told there (was) a bug until G16 
            fi
        fi
        ($debugging) && echo "About to launch generscpcmgjf..."
        generscpcmgjf "$icurinfile" || { solvescpcm=0; export solvescpcm;}
        if [ -n "$(echo "$GAUSS_EXEDIR" | grep g16)" ]; then
            if [ -z "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i '^%Chk=')" ]; then
                activechkf=$(ls -lt ${GAUSS_SCRDIR}/Gau-*.chk | head -1 | gawk '{print $NF}')
                activeoldchkf=$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i '^%OldChk=' | cut -d '=' -f 2)
                [ -n "$activeoldchkf" ] && { newchkname=$(basename "$activeoldchkf"); newchkname="$(dirname "$activeoldchkf")/${newchkname%.chk}_a.chk"; } || newchkname="${GAUSS_LNCHDIR}/${icurinfile%.gjf}_a.chk" # else case should actually never occur
                mv "$activechkf" "$newchkname"
                [ -n "$activeoldchkf" ] && { sed -i '1,/--Link1--/I{s/'"$activeoldchkf"'/&\n%Chk='"$newchkname"'/}' "$icurinfile" && sed -i '1,/--Link1--/I{/'"$activeoldchkf"'/d}' "$icurinfile"; } || sed -i '1,/%NProcShared/Ia%Chk='"$newchkname" "$icurinfile"
            else
                sed -i '1,/--Link1--/I{/^%OldChk/Id}' "$icurinfile"
            fi
            sed -i '1,/--Link1--/I{/#/{s/scrf[^ ]*externaliteration/&,Restart/I}}' "$icurinfile"
            echo "Restarting with the name: $icurinfile..."
            if [ $solvescpcm -lt 3 ]; then
                echo "Fallbacking will be impossible!"
                solvescpcm=3; export solvescpcm
            fi
        else
            if [ $solvescpcm -gt 2 ]; then
                icurinfile="$newfallbackname" # this sub uses name with "_fbk" added for fallbacking; scpcmsolver_rerun uses basic name; for now this is to test which way works better (I prefer this way)
                echo "Restarting with the fallbackfile: $newfallbackname..."
            else
                echo "Cannot solve the SC-PCM problem!"
                return 3
            fi
        fi
    fi
    icuroutfile="${icurinfile%.gjf}.out"
    export curinfile=$icurinfile
    export curoutfile=$icuroutfile
    ( $regclean ) && getridofdirt $firstcurinfile
}


scpcmsolver_rerun() { # do not worry: this solver ALWAYS uses the fallback file (the one already present or newly generated by itself)
    ( $debugging ) && echo "DEBUG: Obtaining the name of fallback file..."
    fallbackbase="${icurinfile%.gjf}"
    drosiba1=0
    while true; do
        drosiba1=$((drosiba1+1))
        fallbackfile="${fallbackbase}_fbk.gjf"
        [ -f "$fallbackfile" ] && break
        fallbackbasenew=${fallbackbase%_1}
        [ "$fallbackbase" == "$fallbackbasenew" ] && break || fallbackbase="$fallbackbasenew"
        [ $drosiba1 -gt 20 ] && break
    done
    ( $debugging ) && echo "DEBUG: Provisional name of fallback file is $fallbackfile..."
    if [ -f "$fallbackfile" ]; then
        icurinfile="$fallbackfile"
        ( $debugging ) && echo "DEBUG: Found a fallback file."
    else
#        nrdone=$(grep -ce "Normal term" $2); #((totlines--))
#        icurinfile=${1%.gjf}_$((nrdone+1)).gjf
#        cp $1 $icurinfile
        newfallbackname=""
        generscpcmgjf "$icurinfile"
        mv "$newfallbackname" "$icurinfile"
        ( $debugging ) && echo "DEBUG: Generated a fallback file."
    fi
    icuroutfile=${icurinfile%.gjf}.out

    # the inconsistent field problem is solved by disabling the rotation of the structure
    while [ -n "$(grep '^\s*#[NPTnpt]*\s' "$icurinfile")" ]; do
        if [ -n "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep -i 'NonEq=')" ]; then
            sed -n '1,/--Link1--/Ip' "$icurinfile" >> "$icurinfile.scpcmtmp"
            sed -i '1,/--Link1--/Id' "$icurinfile"
        else
            break
        fi
    done
    sed -i '/^\s*#[NPTnpt]*\s/{/NoSymm/I!s/#[^!]*/& NoSymm/}' "$icurinfile.scpcmtmp"
    cat "$icurinfile" >> "$icurinfile.scpcmtmp"
    mv "$icurinfile.scpcmtmp" "$icurinfile"

    echo "Restarting with the fallback file with name: $icurinfile..." # this sub uses basic name for fallbacking; scpcmsolver uses name with "_fbk" added; for now this is to test which way works better (I prefer the way of scpcmsolver)
    export curinfile=$icurinfile
    export curoutfile=$icuroutfile
    ( $regclean ) && getridofdirt $firstcurinfile
}

generategjf() {
  icurinfile=$1; icuroutfile=$2
  [ -n "$(grep '^#' "$icurinfile" | grep -i -e 'MP[2345]' -e 'EPT' -e 'CC[S]*D' -e '2PLYP' -e 'Tran' -e 'DSDPBE' -e 'PBE0DH' -e 'PBEQIDH')" ] && postSCF=true || postSCF=false
  ($debugging) && echo "DEBUG: enter generategjf($1 $2)"
  nrdone=$(grep -c "Normal termination" "$2")
  [ $solveimg -gt 0 ] && nrdone=$(sed -n '1,/imaginary frequencies (negative Sig/p' "$2" | grep -c "Normal termination")
  totlines=$(grep -ce "#" "$1")
  totlines=$((totlines+$(grep -c '[ \s]Opt\s\+Freq' "$icurinfile")))
  ($debugging) && echo "DEBUG: nrdone is $nrdone, totlines is $totlines"
  if [ $totlines -gt $nrdone ]; then # totlines is nr of jobs in file, not nr of lines in it...
    echo "Job $((nrdone+1)) failed."
    echo "There were $nrdone formally well done jobs before."

################ LEAVES THE COMPLETED JOBS ONLY IN THE OLD INPUT FILE AND COPIES THE REST TO THE NEW ONE
    icurinfile=${1%.*}_$((nrdone+2)).gjf
    icuroutfile=${2%.*}_$((nrdone+2)).out
    cp $1 $icurinfile || {
        echo "Probably the filename is now too long, ot the disk is full; there is no solution to this right now..."
        echo "Calculation end time: $(date)"
        return 0;
    }
    rm "$1"
    > $1 # a comment will be added before the failed job in the original input file
    if [ $nrdone -gt 0 ]; then
        for kdgs in $(seq $nrdone)
        do
            nroptfreq=$(sarakstu2 <(tac "$icuroutfile" | sed '1,/Normal termination/d') | grep -c '[ \s]Opt\s\+Freq' )
            [ $nroptfreq -gt 0 ] && [ $kdgs -eq $((nrdone+1-nroptfreq)) ] && break
            sed -n '1,/--Link1--/Ip' $icurinfile >> $1 # a comment will be added before the failed job in the original input file
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
    fi
    echo "! the next job failed, hence all below was not calculated" >> "$1"
    cat "$icurinfile" >> "$1" # done meddling with the original input file
    until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < "$icurinfile") -eq 0 ]; do
        sed '1 d' -i $icurinfile
    done
    # ((nrdone++)) # henceforth nrdone is the number of FAILED job
    
    # deletes jobs which are now transfered to next file from failed input file:
    # diff --changed-group-format='%>' --unchanged-group-format='' $1 $icurinfile > schwabische; mv schwabische $1 # ©merp@stack overflow
    # tail -n +2 "$icurinfile" | tee "$icurinfile" > /dev/null # tail usage borrowed from http://stackoverflow.com/questions/339483/how-can-i-remove-the-first-line-of-a-text-file-using-bash-sed-script; if i do not use tail, i get empty file! I do not know why.

################ GATHERS SOME INFORMATION ABOUT THE FAILED STEP AND OUTPUTS IT
    failedsteproute=$(ifind $icurinfile "#")
    failedstep=$(ifind $icurinfile ":::")
    sed -n '/^#/{n;n;n;n;n;:a;p;n;/--Link1--/!ba;:end;n;$!bend}' "$icurinfile" > old.addinput.${mygorgeouspid}.$HOSTNAME
    [ -f "new.addinput.${mygorgeouspid}.$HOSTNAME" ] && rm "new.addinput.${mygorgeouspid}.$HOSTNAME"
    > new.addinput.${mygorgeouspid}.$HOSTNAME 
    [ -n "$(sed -n '1{s/^\s*$//;p}' old.addinput.${mygorgeouspid}.$HOSTNAME)" ] && sed -i '1,/^\s*$/d' old.addinput.${mygorgeouspid}.$HOSTNAME
    echo "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"; echo
    failedstepshort="$(echo $failedstep | cut -f 6 -d ' ') $(echo $failedstep | cut -f 7 -d ' ')"
    echo "Failed step is $failedstepshort; its Route/Title sections are below."
    echo "$failedsteproute"; echo ""
    echo "$failedstep"
    echo "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"
    echo "Its additional input section is: "
    cat old.addinput.${mygorgeouspid}.$HOSTNAME
    failedstep=$failedstepshort
    echo; echo "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"

###################################################################
# The next chunk was meant to save SCRF=ExternalIteration jobs, but this is now done by the two solvers and geteratescpcmgjf subroutine
    #loclast=$(grep -i -n -m $((nrdone+1)) '%NProcShared' $icurinfile | tail -n 1 | cut -d : -f 1)
        #loclastche=$(sed -n "$((loclast-1))"'p' $icurinfile | grep -i '%')
        #while [ -n "$loclastche" ]; do
        #    loclast=$((loclast-1))
        #    loclastche=$(sed -n "$((loclast-1))"'p' $icurinfile | grep -i '%')
        #done
        #addingneqw=""
    #laststep=$(sed -n $loclast',/--Link1--/Ip' $icurinfile | grep ':::' | cut -d ' ' -f 7)
    #if [ -n "$(sed -n $loclast',/--Link1--/Ip' $icurinfile | grep -i 'Noneq=Read')" ] && [ -z "$(sed -n $loclast',/--Link1--/Ip' $icurinfile | grep -i ' Opt')" ] && [ -z "$(sed -n $loclast',/--Link1--/Ip' $icurinfile | grep -i 'OldChk=')" ]; then
        #    fwwr=""
    #    iswrther="$(sed -n '1,'"$loclast"'p' $icurinfile | grep -i 'NonEq=Write')"
        #    if [ -z "$iswrther" ]; then
        #        for uyu in "$(ls -ltc ${firstcurinfile%.gjf}*.gjf | sed '1,2d' | rev | tr -s ' ' | cut -d ' ' -f 1 | rev | xargs)"; do
        #            iswrther="$(cat $uyu | grep -i 'NonEq=Write')"
        #            if [ -n "$iswrther" ]; then
        #                fwwr="$uyu"
        #                break;
        #            fi
        #        done
        #    else
        #        fwwr="$icurinfile"
        #    fi
        #    wrtlinen=$(grep -i -n 'NonEq=Write' "$fwwr" | tail -n 1 | cut -d : -f 1)
        #    wrtlinen1=$(sed -n '1,'"$wrtlinen"'p' "$fwwr" | grep -i -n 'Link1--' | tail -n 1 | cut -d : -f 1)
        #    wrtlinen1=$((wrtlinen1+1))
        #    while [ -z "$(sed -n "$wrtlinen1"'p' "$fwwr" | tr -d ' ')" ]; do
        #        wrtlinen1=$((wrtlinen1+1))
        #    done
        #    wrtlinen2=$(sed -n "$wrtlinen"',/--Link1--/Ip' "$fwwr"| sed '1d' | grep -i -n 'Link1--' | tail -n 1 | cut -d : -f 1)
        #    wrtlinen2=$((wrtlinen2+wrtlinen))
        #    addingneqw="$(sed -n "$wrtlinen1"','"$wrtlinen2"'p' "$fwwr")"
    #    #[ $laststep -eq 3 ] && ((nrdone-=2))
    #fi

################ SOME TRIALS TO INCLUDE FAST FREQUENCY CHECK (NEED TO INCLUDE AUTOMATIC CHANGE OF COORDINATES AFTER FINDING OUT THAT WE REACHED A SADDLE POINT)
    # No way to check frequencies with smaller BS: as the difference is about 10 cm-1, it can readily exceed small first freq. of a complex molecule
    #if [ -n "$(tail -10 ${1%_U*}.logg | grep -e 'Something weird' -e 'Not enough disk')" ] && [ -n "$(echo $failedstep | grep 'NoRaman')" ]; then
    #    sed -n '1,/#/p' $icurinfile > $icurinfile_freqcheck
    #fi

################ TO REMOVE JOBS WHICH MAY USE CHECKPOINT FILES FROM THE CORRUPTED JOBS (E.G., UNFINISHED GEOMETRY OPTIMIZATIONS WHICH WERE TO BE FOLLOWED BY PROPERTY CALCULATIONS)
################ HERE, NAMES OF SUCH CHKs ARE OBTAINED (LATER FAILED JOBS WILL BE DELETED...)
    if ( $stopifchk ); then
        prechk=$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i -E "%Chk" | sed 's/\%Chk=//I') # OldCheck is not affected, so remains
        oldprechk=$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i -E "%OldChk" | sed 's/\%[A-Z]*[a-z]*Chk=//')
    fi
    # does not work in old bash versions (<4):   perechk=${prechk,,}; prechk=${prechk:`expr match "$perechk" '%[a-z]*.='`}
    ($debugging) && echo "DEBUG: Sought defectous phrase is: $prechk"
    ($debugging) && echo "DEBUG: Sought counter-defectous phrase is: $oldprechk"
    if [ $solvescf -gt 0 ] || [ $solvefmm -gt 0 ] || [ $solvecphf -gt 0 ] || [ $solvegeom -gt 0 ] || [ $solveacc2 -gt 0 ] || [ $solverwf -gt 0 ] || [ $solvecav -gt 0 ] || [ $solveimg -gt 0 ]; then
        if [ -n "$(cat old.addinput.${mygorgeouspid}.$HOSTNAME | grep -i 'NonEq=Read')" ]; then
            solvescpcm=3 && export solvescpcm && echo "Enabling also the SC-PCM fallback generation because the job contained NonEq=Read..."
        else
            solvescpcm=0 && export solvescpcm
        fi
    fi

############################### SOLVER SECTION STARTS ###############################
    echo "Solving status: solvescf=$solvescf, solvemcscf=$solvemcscf, solvefmm=$solvefmm, solvecphf=$solvecphf, solvegeom=$solvegeom, solveacc2=$solveacc2, solverwf=$solverwf, solvecav=$solvecav, solvescpcm_redo=$solvescpcm_redo, solvescpcm=$solvescpcm, solveimg=$solveimg."

################ FAST SOLVER FOR THE CASE OF OPERATOR FORGETTING TO ADD Geom=Check
    [ -n "$(tail -n 20 $2 | grep "no atoms in this input stru")" ] && [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'Geom[=(]*Check')" ] && sed -i '1,/--Link1--/I{/^#/s/.*/& Geom=Check/}' $icurinfile && solvescf=3 # if no solver is active, the job would be skipped
    
################ IF NO SOLVER WILL BE USED (THE FAILED JOB IS THEN REMOVED HERE):
    ################################ (otherwise the job may be needed by the solver below)
    for ewald in 1 2; do # this is to fall back to the no-solver case if the resulting route line is the same as the initial route line
       if [ $solvescf -lt 3 ] && [ $solvefmm -lt 3 ] && [ $solvecphf -lt 3 ] && [ $solvegeom -lt 3 ] && [ $solveacc2 -lt 3 ] && [ $solverwf -lt 3 ] && [ $solvecav -lt 3 ] && [ $solvescpcm_redo -lt 3 ] && [ $solvescpcm -lt 3 ] && [ $solveimg -lt 3 ]; then
           ($debugging) && echo "About to remove the first job..."
           [ -z "$(echo "carefuleness"; tail -7 ${firstcurinfile%.gjf}_failed.gjf 2>/dev/null | grep -i '\-\-Link1\-\-')" ] && [ $(wc -l < "${firstcurinfile%.gjf}_failed.gjf") -gt 5 ] && echo -en "\n--Link1--\n\n" >> ${firstcurinfile%.gjf}_failed.gjf
           if [ $(wc -l < "$2") -gt 7 ] && [ -n "$(tac "$2" | sed -n '1,/Entering Link 1/p' | grep 'Structure from the checkpoint file')" ]; then
               ($debugging) && echo "Replacing the Geom=Check with actual structure from earlier (while simply removing the failed job)..."
               errstruct="$(tac "$2" | sed -n '1,/Entering Link 1/p' | tac | sed -n '/Structure from the checkpoint file/,/Recover connectivity data from disk./p' | sed '1,3d' | sed 's/,0,-/  -/;s/,0,/   /;s/,-/  -/g;s/,/   /g;$d' | sed 's/\r//;s/$/\\/')"
               if [ -z "$(echo "$errstruct" | grep -e 'dumping /fiocom/')" ]; then
                   erstrln=$(grep -n '^[ ]*#' ${firstcurinfile%.gjf}_failed.gjf | tail -1 | cut -d ':' -f 1) # thanks terdon unix.stackexchange.com/questions/112159
                   erstrln=$((erstrln+4))
                   sed -i "$erstrln"' a'"$errstruct" "${firstcurinfile%.gjf}_failed.gjf"
                   sed -i 's/\\$//' "${firstcurinfile%.gjf}_failed.gjf"
                   vecaisgess=$(sed -n "$erstrln"'{s@.*\( Guess[^ ]*\).*@\1@I}')
                   jaunaisgess=$(echo "$vecaisgess" | sed 's/Read//I;s/,,/,/g;s/(,/(/;s/,)/)/')
                   sed -i "$erstrln"'{s/.*/& /;s/ Geom[=(]*Check//I;s/'"$vecaisgess"'/'"$jaunaisgess"'/}' "${firstcurinfile%.gjf}_failed.gjf"
               else
                   echo "Pitifully retreating solver. Proceeding with next ones..."
                   export solvemcscf=0 solvescf=0 solvefmm=0 solvecphf=0 solvegeom=0 solveacc2=0 solverwf=0 solvescpcm_redo=0 solvescpcm=0 solvecav=0 solveimg=0
               fi
           fi
           for buni in "$icurinfile" "${icurinfile%.gjf}_fbk.gjf"; do
               [ ! -f "$buni" ] || { [ $(wc -l < "$2") -gt 7 ] && [ -n "$(echo "$buni" | grep '_fbk[0-9_]*.gjf')" ]; } && continue
               # previous line had the following:
               #  || [ $(wc -l < "$2") -gt 7 ]
               # but this caused the first job not to be removed when jobs were simple SPs; why did I add this? for _fbk?
               [ -n "$(echo "$buni" | grep '_fbk[_1]*.gjf')" ] && destrucnt=2 || destrucnt=1
               echo '!the following comes from: '"$1" >> ${firstcurinfile%.gjf}_failed.gjf
               for nani in $(seq 1 $destrucnt); do
                   deathrow="$(sed -n '1,/--Link1--/Ip' $buni | tee -a ${firstcurinfile%.gjf}_failed.gjf)" # added since v. 0.4.0.9
                   ($debugging) && echo "DEBUG: generategjf: Icurinfile is $buni, while the first argument is $1"
                   ($debugging) && { echo "DEBUG: properties of both:"; ls -lh  $buni; ls -lh $1; echo "-----"; }
                   ($debugging) && { echo "DEBUG: sarakstu2 of buni:"; sarakstu2 $buni; }
                   if [ -n "$(echo "$deathrow" | grep '^[[:space:]]*!lutil')" ]; then
                       sed -n '/\!lutil/,$p' -i $buni
                   else
                       sed '1,/--Link1--/Id' -i $buni # deletes everything until first "--Link1--", including that line
                   fi
                   ($debugging) && { echo "DEBUG: properties of both:"; ls -lh  $buni; ls -lh $1; echo "-----"; }
                   until [ -n "$(head -n 1 $buni | grep '%')" ] || [ $(wc -c $buni | cut -f 1 -d ' ') -lt 20 ]; do
                       sed '1 d' -i $buni 
                   done
                   ($debugging) && { echo "DEBUG: properties of both:"; ls -lh  $buni; ls -lh $1; echo "-----"; }
               done # deleting first or first and second jobs
           done # deleting both in the next input and in its _fbk (if present)
           break # if this is not from the case when it is impossible to solve
################ IF SOME SOLVER IS TO BE USED
       else
           mv $icurinfile ${icurinfile%_*}_$((nrdone+1)).gjf 
           icurinfile=${icurinfile%_*}_$((nrdone+1)).gjf
           icuroutfile=${icurinfile%_*}_$((nrdone+1)).out
           if [ $solvemcscf -gt 2 ]; then
               echo "Solving problems of MC-SCF..."
               mcscfsolver $1 $2
           fi # if solving MC-SCF problems
           
           if [ $solvescf -gt 2 ] || [ $solvecav -gt 2 ]; then # if there is QC it MUST be the first option to SCF, otherwise solving might not work
               [ $solvecav -gt 2 ] && echo "Solving problems of SCF (cavity)..." || echo "Solving problems of SCF..."
               scfsolver $1 $2
               [ -f "scfsolver.$HOSTNAME.tmp" ] && solvecav=$(cat scfsolver.$HOSTNAME.tmp)
               [ -f "scfsolver.$HOSTNAME.tmp" ] && rm scfsolver.$HOSTNAME.tmp
           fi # if solving SCF problems
           
           if [ $solvescpcm_redo -gt 2 ]; then # if there is QC it MUST be the first option to SCF, otherwise solving might not work
               echo "Solving problems of SC-PCM by using NoSymm/fallback file..."
               scpcmsolver_rerun $1 $2
           fi # if solving SC-PCM problems which should be soluble by rerun
           
           if [ $solvescpcm -gt 2 ]; then # if there is QC it MUST be the first option to SCF, otherwise solving might not work
               echo "Solving problems of SC-PCM convergence..."
               scpcmsolver $1 $2
           fi # if solving SC-PCM convergence problems
           
           if [ $solvegeom -gt 2 ]; then
               echo "Solving problems of geometry optimization..." # Still not ready for production work...
               geomsolver $1 $2 $solvegeom
           fi # if solving geometry issues
               
           if [ $solveimg -gt 2 ]; then
               echo "Solving problems of saddle-point geometry..."
               imgsolver $1 $2
           fi
               
           if [ $solveacc2 -gt 2 ]; then
               acc2esolver $1 $2
           fi
           
           if [ $solvecphf -gt 2 ]; then
               echo "Solving problems of CPHF..."
               cphflast="$(tac $icuroutfile | grep -m 1 ' vectors produced by pass*Test12= ' | cut -d '=' -f 2 | cut -d ' ' -f 2)"
               [ -z "$cphflast" ] && echo "Solving unsuccessful!" && export icurinile="${icurinfile%.gjf}_1_1_1_1_1_1.gjf"
               if [ -z "$(echo "$cphflast" | grep '+')" ]; then
                   [ $solveacc2e -lt 3 ] && acc2esolver $1 $2
               else
                   if [ -z "$(grep -m 1 '#' $icurinfile | grep -i 'IOp(10/63=1)')" ]; then
                       sed -i '1,/#/s/Polar[^ ]*/& IOp(10\/63=1)/I' $icurinfile # disabling FMM only for CPHF
                   elif [ -z "$(grep -m 1 '#' $icurinfile | grep -i -e 'IOp(10/8=1)' -e 'IOp(10/8=3)' -e 'IOp(10/8=-1)')" ]; then
                       sed -i '1,/#/s/Polar[^ ]*/& IOp(10\/8=1)/I' $icurinfile # each var in separate space
                   elif [ -z "$(grep -m 1 '#' $icurinfile | grep -i -e 'IOp(10/8=3)' -e 'IOp(10/8=-1)')" ]; then
                       sed -i '1,/#/s/IOp(10\/8=1)/IOp(10\/8=3)/I' $icurinfile # direct inversion
                   elif [ -z "$(grep -m 1 '#' $icurinfile | grep -i 'IOp(10/8=-1)')" ]; then
                       sed -i '1,/#/s/IOp(10\/8=3)/IOp(10\/8=-1)/I' $icurinfile # each var separately
                   fi
               fi
           fi

           if [ $solvefmm -gt 2 ]; then
               echo "Solving problems of FMM..."
                   if [ -z "$(grep -m 1 '#' $icurinfile | grep -i 'IOp(10/63=1)')" ]; then
                       sed -i '1,/#/s/Polar[^ ]*/& IOp(10\/63=1)/I' $icurinfile # disabling FMM only for CPHF
                   fi
           fi
                
           if [ $solvecav -gt 2 ]; then
               echo "Solving problems of SCRF cavity..."
               if [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'OFac=')" ]; then
                   nadsects=""
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'connect')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'readfreeze')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'modredun')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'readisotop')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'charge')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i -e 'ADMP' -e 'BOMD')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'report')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'readharmonic')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'gen')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'genecp')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'field')" ] && nadsects="$nadsects;n;/^$/!n"
                   [ -n "$(grep -m 1 '#' $icurinfile | grep -i 'extradensitybas')" ] && nadsects="$nadsects;n;/^$/!n"

                   [ -n "$nadsects" ] && nadsects="$nadsects;"

                   if [ -n "$(grep -m 1 '#' $icurinfile | grep -o '[Ss][Cc][Rr][Ff][^ ]*' | grep -i 'read')" ]; then
                           sed -i '1,/--Link1--/I{/#/{n;n;n;n;:a;n;/^[ ]*$/!ba;'"$nadsects"'n;a \
OFac=0.8    RMin5
}}' $icu   rinfi
                   else
                                sed -i '1,/--Link1--/I{/#/{n;n;n;n;:a;n;/^[ ]*$/!ba;'"$nadsects"'a \
OFac=0.8    RMin5\n
}}' $icu   rinfi
                                sed -i '1,/--Link1--/I{/#/s/scrf[(=]*/scrf=(Read,/I}' $icurinfile
                   fi
                   sed -i '1,/--Link1--/I{/OFac=/a \
! Please reposition the above line yourself if this does not work.
}' $icurinfile
# the solutions proposed by Dr. Joaquin Barroso https://joaquinbarroso.com/2011/10/24/polarizable-continuum-model-pcm-2/
               else
                  if [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'OFac=0.8 ')" ]; then
                      sed -i '1,/--Link1--/I{s/OFac=[^ ]*/OFac=0.8/I}' $icurinfile
                  elif [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'OFac=0.75 ')" ]; then
                      sed -i '1,/--Link1--/I{s/OFac=[^ ]*/OFac=0.75/I;/OFac=/Is/$/ ! OFac=0.8/}' $icurinfile
                  fi
                  
                  if [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'RMin=0.5 ')" ]; then
                      sed -i '1,/--Link1--/I{s/RMin=[^ ]*/RMin=0.5/I}' $icurinfile
                  elif [ -z "$(sed -n '1,/--Link1--/Ip' $icurinfile | grep -i 'RMin=0.6 ')" ]; then
                      sed -i '1,/--Link1--/I{s/RMin=[^ ]*/RMin=0.6/I;/RMin=/Is/$/ ! RMin=0.5/}' $icurinfile
                  fi
               fi
           fi

           if [ $solverwf -gt 2 ]; then
               echo "Redistributing disk space..."
               rwfsolver $1 $2
               export curinfile=$icurinfile
               export curoutfile=$icuroutfile
               export solvescf=0; export solvegeom=0
               return 1
           fi

           if [ "${icurinfile: -8}" == "_fbk.gjf" ]; then
               otraisbeidzas=$(cat $icurinfile | grep -nm 2 -e '--Link1--' | cut -d ':' -f 1 | xargs | tr ' ' ',')
               tagadroute=$(sed -n "$otraisbeidzas"'p' $icurinfile | grep "#")
           else
               otraisbeidzas="1,$(cat $icurinfile | grep -nm 1 -e '--Link1--' | cut -d ':' -f 1)"
               tagadroute=$(sed -n "${otraisbeidzas}p" $icurinfile | grep -m1 "#")
           fi
           jaunsroute=$(echo "$tagadroute" | sed -n 's/ /\n/g;p' | gawk '!x[$0]++' | xargs)
           # the gawk '!x[$0]++' statement works as follows: the line ($0) is added to the array as a key, then the element evaluates by default as empty string (if that key (string) was never referenced before) which is then negated by ! and thus becomes true, which by default triggers printing of $0 in gawk. Then the value for key is incremented, so when it is encountered next time negation turns it into the false and $0 is not printed. Thanks to Archemar and Isaac, https://unix.stackexchange.com/questions/159695
           # jaunsroute=$(echo "$tagadroute" | sed -n 's/,/\n/g;p' | gawk '!x[$0]++' | tr '\n' ',' | xargs)
           sed -i "$otraisbeidzas"'{s.'"$tagadroute"'.'"$jaunsroute"'.}' "$icurinfile"
           sed -n "$otraisbeidzas"'{/^#/{n;n;n;n;n;:a;p;n;/--Link1--/!ba;:end;n;$!bend}}' "$icurinfile" > new.addinput.${mygorgeouspid}.$HOSTNAME
           [ -n "$(sed -n '1{s/^\s*$//;p}' new.addinput.${mygorgeouspid}.$HOSTNAME)" ] && sed -i '1,/^\s*$/d' new.addinput.${mygorgeouspid}.$HOSTNAME
           echo "< removed   > added" > diff.addinput.${mygorgeouspid}.$HOSTNAME
           echo >> diff.addinput.${mygorgeouspid}.$HOSTNAME
           diff "old.addinput.${mygorgeouspid}.$HOSTNAME" "new.addinput.${mygorgeouspid}.$HOSTNAME" >> diff.addinput.${mygorgeouspid}.$HOSTNAME
            nosirtagad="${icurinfile%.gjf}"; nosbustagad="${nosirtagad//_fbk/}"
            disasterindicator=$(echo "${icurinfile: -16}" | tr '3' '1' | tr '2' '1') # 3 is from geomopt solving, with adding Stable=Opt/Opt=CalcAll steps; 2 is from SC-PCM
           { [ "$disasterindicator" == "_1_1_1_1_1_1.gjf" ] || [ $((${#nosirtagad}-${#nosbustagad})) -gt 8 ]; } && (! $neverstop ) && absolute_disaster=true || absolute_disaster=false
           # [ $(tac "$icurinfile" | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ]  <-- this I leave out now because the situation obviously cries for user intervention
           diffroute="$jaunsroute"
           for sgh in ${failedsteproute%\!*}; do diffroute=$(echo "$diffroute" | sed 's@'"$sgh"'@@'); done
           if [ "$failedsteproute" == "$jaunsroute" ] || ( $absolute_disaster ); then
               if [ -z "$(cat "diff.addinput.${mygorgeouspid}.$HOSTNAME")" ] || ( $absolute_disaster ); then
                   if ($debugging); then
                       if ($absolute_disaster); then
                        echo "XXXPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPXXX"
                        echo -e "\nProposed solution in the route section is:\n"; echo "$jaunsroute"; echo; echo "> > > $diffroute"; echo
                        echo "XXXPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPXXX"
                       fi
                       echo "XXXPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPXXX"
                       echo -e "\nProposed solution in the additional input section was goiing to be:\n"; echo $(cat "diff.addinput.${mygorgeouspid}.$HOSTNAME"); echo
                       echo "XXXPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPXXX"
                   fi
                   echo "Pitifully retreating solver. Proceeding with next ones..."
                   export solvemcscf=0 solvescf=0 solvefmm=0 solvecphf=0 solvegeom=0 solveacc2=0 solverwf=0 solvescpcm_redo=0 solvescpcm=0 solvecav=0 solveimg=0
               else
                   echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"
                   echo -e "\nProposed solution in the additional input section is:\n"; echo $(cat "diff.addinput.${mygorgeouspid}.$HOSTNAME"); echo
                   echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"
                   rm new.addinput.${mygorgeouspid}.$HOSTNAME diff.addinput.${mygorgeouspid}.$HOSTNAME
                   break # continue without falling back to the no-solver case
               fi
           else
               echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"
               echo -e "\nProposed solution in the route section is:\n"; echo "$jaunsroute"; echo; echo "> > > $diffroute"; echo # multiple echos are the warranty against special characters in the Route section
               echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"
               if [ -n "$(cat "diff.addinput.${mygorgeouspid}.$HOSTNAME")" ]; then
                   echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"-
                   echo -e "\nProposed solution in the additional input section is:\n"; echo $(cat "diff.addinput.${mygorgeouspid}.$HOSTNAME"); echo
                   echo "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP"
                   rm new.addinput.${mygorgeouspid}.$HOSTNAME diff.addinput.${mygorgeouspid}.$HOSTNAME
               fi
               break # continue without falling back to the no-solver case
           fi
           [ -f "diff.addinput.${mygorgeouspid}.$HOSTNAME" ] && rm new.addinput.${mygorgeouspid}.$HOSTNAME diff.addinput.${mygorgeouspid}.$HOSTNAME
                
           #[ -n "$(echo "$failedsteproute" | grep ' Opt ')" ] && sed -i '0,/ Opt /s//&=CalcFC /' $icurinfile || 
           # such use of sed replaces only the first match in file; s// without arguments mean to use the last expression entered. Thank You, Ben Hoffstein from stackoverflow
       fi # if a solver is to be executed
    done # cycle for skipping unsuccessfully solved jobs

    filesiz=$(wc -c < $icurinfile)
    if [ $(grep -c "#" $icurinfile) -lt 1 ]; then
        rm $icurinfile
        return 0
    fi

################ TO REMOVE JOBS WHICH MAY USE CHECKPOINT FILES FROM THE CORRUPTED JOBS (E.G., UNFINISHED GEOMETRY OPTIMIZATIONS WHICH WERE TO BE FOLLOWED BY PROPERTY CALCULATIONS)
################ HERE, THE ACTUAL REMOVAL IS PERFORMED
    
#    checkforupnextgeompt=0
#   if [ -n "$(echo "$failedsteproute" | grep -i ' Opt')" ]; then
#        [ -n "$(sed -n '1,/--Link1--/Ip' "$icurinfile" | grep '^\s*#[TNPtnp]*\s' | grep -i ' Opt')" ] && checkforupnextgeompt=3 # this is actually better handled inside the erasedefectous sub
#   fi
    if ( $stopifchk ) && [ -n "$prechk" ] && [ $filesiz -gt 20 ] && [ $solvemcscf -lt 3 ] && [ $solvescf -lt 3 ] && [ $solvefmm -lt 3 ] && [ $solvecphf -lt 3 ] && [ $solvecav -lt 3 ] && [ $solvegeom -lt 3 ] && [ $solverwf -lt 3 ] && [ $solveacc2 -lt 3 ] && [ $solvescpcm_redo -lt 3 ] && [ $solvescpcm -lt 3 ] && [ $solveimg -lt 3 ]; then #  [[ "$failedstep" != "GeometryOptimization 1" ]] && [[ "$failedstep" != "TroublesomeOptimization 2" ]] && && [ $checkforupnextgeompt -lt 3 ]
        if [ -n "$(echo "$failedsteproute" | grep -e ' Opt')" ] || [ -n "$(cat old.addinput.${mygorgeouspid}.$HOSTNAME | grep -i 'noneq=write')" ]; then
            erasedefectous $prechk $oldprechk
            [ -f "${icurinfile%.gjf}_fbk.gjf" ] && (icurinfile="${icurinfile%.gjf}_fbk.gjf"; erasedefectous $prechk $oldprechk)
        fi
    fi
    rm old.addinput.${mygorgeouspid}.$HOSTNAME

################ ALSO, IF DERIVATIVES WERE NOT AVAILABLE FOR THE METHOD SELECTED (THIS LINE IS USEFUL FOR LONG BATCH JOBS)
    if [ -n "$remmaxder" ]; then
        erasedefectous $remmaxder
        [ -f "${icurinfile%.gjf}_fbk.gjf" ] && (icurinfile="${icurinfile%.gjf}_fbk.gjf"; erasedefectous $remmaxder)
        export remmaxder=""
    fi

################ FINAL MESSAGES AND EXPORTING THE VARIABLES

    export solvescf=0
    export solvemcscf=0
    export solvefmm=0
    export solvecphf=0
    export solvecav=0
    export solveacc2=0
    export solvegeom=0
    export solveimg=0
    export solverwf=0
    export solvescpcm_redo=0
    export solvescpcm=0
    if [ $filesiz -gt 4 ]; then
            # if [ -n "$addingneqw" ]; then
            #     addingneqw="$addingneqw\n\n$(cat "$icurinfile")"
            #     echo "$addingneqw" > "$icurinfile"
            # fi
        axelbant=0; { [ $solvescf -gt 2 ] || [ $solvemcscf -gt 2 ]  || [ $solvefmm -gt 2 ] || [ $solvecphf -gt 2 ] || [ $solvecav -gt 2 ] || [ $solvegeom -gt 2 ] || [ $solveacc2 -gt 2 ] || [ $solvescpcm_redo -gt 2 ] || [ $solvescpcm -gt 2 ] || [ $solverwf -gt 2 ] || [ $solveimg -gt 2 ]; } && axelbant=1
        echo "Last job removed after the failure was $((1+nrdone-axelbant)). Proceeding with the rest, copied to input file $icurinfile..."
        ($debugging) && echo "Relaunch time (from the library): $(date)" || echo "Relaunch time: $(date)"
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        return 1;
    else
        rm $icurinfile
        echo "Nothing can be launched or rerun at this point, so will exit now."
        echo "Calculation end time: $(date)"
        return 0;
    fi
  else
    echo "It seems that everything is... done successfully?!" #  "Last job failed. All preceding ones were just fine." #???
    echo "Calculation end time: $(date)"
    return 0;
  fi
} # end of generategjf

checkout() {
    ($debugging) && echo "DEBUG: enter checkout($1 $2)"
    if [ -z "$2" ]; then # fatal error, Gaussian was not started
        echo "====================="; echo "Gaussian did not get to writing to the output file!"; echo "====================="
        ls -l "${1%.gjf}"*
        diskspace $1    # ramsfield is implied
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Gaussian not started on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        export solvescf=0 solvefmm=0 solvecphf=0 solveacc2=0 solvegeom=0 solverwf=0 solvecav=0 solvescpcm_redo=0 solvescpcm=0 solveimg=0
        generategjf $1 $2 && return 0 || return 1
    elif [ "$3" == "true" ]; then # takeover is active
        return 2
    elif [ ! -f $2 ]; then # if .out file does not exist, print initial info
        # sed -i -e '$a\ ' $1 # eliminates the notorious case of lacking EOF, which causes g09 to exit...
        echo "Starting Gaussian for the first job in the list..."
        return 2
    elif [ -n "$(tail -n 20 $2 | grep -e ' syntax error was detected in the input line')" ]; then
        echo "====================="; echo "Syntax error buried this job. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        export solvescf=0 solvefmm=0 solvecphf=0 solveacc2=0 solvegeom=0 solverwf=0 solvecav=0 solvescpcm_redo=0 solvescpcm=0 solveimg=0
        echo "Syntax error(s) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e 'Out-of-memory error in routine ')" ]; then
        echo "====================="; echo "Requested too little RAM. Stopping execution."; echo "====================="
        ramsfield
        sleep 100 # hopefully enough
        ( $regclean ) && getridofdirt $firstcurinfile
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        echo "Little-RAM-requested problems on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -E "galloc|ot enough mem")" ]; then
        echo "====================="; echo "Requested too much RAM. Stopping execution."; echo "====================="
        sleep 100 # hopefully enough
        ramsfield
        ( $regclean ) && getridofdirt $firstcurinfile
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        echo "Out of RAM on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "SC-PCM: Convergence not achieved within")" ] ; then
        echo "====================="; echo "SC-PCM did not converge in time... Trying to restart."
        echo "====================="
        ( $regclean ) && rm $GAUSS_SCRDIR/*.rwf
        ( $regclean ) && [ -d "$GAUSS_SPRSCRDIR" ] && rm $GAUSS_SPRSCRDIR/*.rwf
        ( $regclean ) && [ -d "$GAUSS_SPRSCRDIR2" ] && rm $GAUSS_SPRSCRDIR2/*.rwf
        nosirtagad="${2%.out}"; nosbustagad="${nosirtagad//_fbk/}"
        ($debugging) && echo "DEBUG: number of _fbk found is $(((${#nosirtagad}-${#nosbustagad})/4))"
        if [ $((${#nosirtagad}-${#nosbustagad})) -gt 8 ] || [ "${2: -14}" == "_2_2_2_2_2.out"  ]; then # actually _fbk is 4 symbols long, so twice is 8
            echo "Pitifully retreating solver. Proceeding with next ones..."
            echo "SC-PCM did not converge, solutions failed on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            solvescpcm=0
            ( $regclean ) && getridofdirt $firstcurinfile
            generategjf ${1%_fbk.gjf}.gjf ${2%_fbk.out}.out && return 0 || return 1
        else
            [ $trysolve -gt 0 ] && { solvescpcm=3; echo "Trying to solve the issue..."; } || solvescpcm=0
            echo "SC-PCM did not converge on $HOSTNAME for ${2%.out} at $(date), solve status $solvescpcm" >> $HOME/CalcLog.logg.$HOSTNAME
            generategjf $1 $2 && return 0 || return 1
        fi
    elif [ -n "$(tail -n 20 $2 | grep -e "Illegal MolTyp in RwMol1" -e "Inconsistent number of fixed charges for non-equilibrium.")" ] ; then
        echo "====================="; echo "SC-PCM reaction field in the checkpoint is corrupted (orientation issues?)... Trying to restart."
        echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        nosirtagad="${2%.out}"; nosbustagad="${nosirtagad//_fbk/}"
        ($debugging) && echo "DEBUG: number of _fbk found is $(((${#nosirtagad}-${#nosbustagad})/4))"
        if [ $((${#nosirtagad}-${#nosbustagad})) -gt 8 ] || [ "${2: -14}" == "_2_2_2_2_2.out"  ]; then
            echo "Pitifully retreating solver. Proceeding with next ones..."
            solvescpcm_redo=0
        else
            [ $trysolve -gt 0 ] && { solvescpcm_redo=3; echo "Trying to solve the issue..."; } || solvescpcm_redo=0
        fi
        echo "SC-PCM checkpoint or geometry orientation corrupted on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "End of file in")" ] || [ -n "$(tail -n 20 $2 | grep "End of line while")" ]; then
        echo "====================="; echo "Lacking final LF or one before --Link1--... Trying to restart."
        echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        echo "Restarting with name $icurinfile..."
        for kdgs in $(seq $donlines); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        perl -0644 -i -pe 's/\n(.*[\S]+)\n(--Link1--)/\n$1\n\n$2/g' $icurinfile # adds newline only if missing
        echo "" >> $icurinfile
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        echo "Lacking a final \n on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        return 1
    elif [ -n "$(tac $2 | sed -n '1,/Entering Link 1/p' | grep -e "Enter MCSCF program")" ] && [ -n "$(tail -n 20 $2 | grep -e 'Convergence failure\.')" ]; then
        echo "====================="; echo "MCSCF convergence failure. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        [ $trysolve -gt 0 ] && { solvemcscf=3; echo "Trying to solve the issue..."; } || solvemcscf=0
        #[ "${2: -6}" == "_1.out" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvemcscf=0; } # 1 (?) solutions up to now
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}")" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvemcscf=0; }
        #fi
        echo "MC-SCF diverged on $HOSTNAME for ${2%.out} at $(date), solve status $solvemcscf" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "criterion not met" -e "No lower point found -- run aborted" -e 'Convergence failure\.' -e 'FmT array not big enough in TabGmT')" ]; then
        echo "====================="; echo "SCF convergence failure. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        [ $trysolve -gt 0 ] && { solvescf=3; echo "Trying to solve the issue..."; } || solvescf=0
        #[ "${2: -36}" == "_1_1_1_1_1_1_1_1_1_1_1_1_1_1_1_1.out" ] || [ $(ofind "$2" '#' | grep '#' | grep -o '[Nn][Dd]amp' | wc -l) -gt 1 ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvescf=0; } # 10 solutions up to now
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvescf=0; }
        #fi
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        echo "SCF diverged on $HOSTNAME for ${2%.out} at $(date), solve status $solvescf" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "MkFkSp is stupid about lin\. deps\.")" ]; then
        echo "====================="; echo "Possibly too obfuscated SCF options. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        [ $trysolve -gt 0 ] && { solvescf=3; echo "Trying to solve the issue..."; } || solvescf=0
        echo "SCF diverged on $HOSTNAME for ${2%.out} at $(date), solve status $solvescf" >> $HOME/CalcLog.logg.$HOSTNAME
        #[ "${2: -36}" == "_1_1_1_1_1_1_1_1_1_1_1_1_1_1_1_1.out" ] || [ $(ofind "$2" '#' | grep '#' | grep -o '[Nn][Dd]amp' | wc -l) -gt 1 ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvescf=0; } # 10 solutions up to now
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvescf=0; }
        #fi
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(sed '/dumping \/fiocom/,/Error termin/d' $2 | tail -n 20 | grep -e 'o file to extend for' -e 'formation cannot fit in the' -e 'File extend in NtrEx1 failed')" ]; then
        echo "====================="; echo "Not enough disk space available for integrals or transformation. Stopping execution."; echo "====================="
        echo "Last 50 lines of the output are:"
        tail -50 $2; echo "====================="
        [ $trysolve -gt 0 ] && { solverwf=3; echo "Trying to solve the issue..."; } || solverwf=0
        echo "No disk space (int/rwf) on $HOSTNAME for ${2%.out} at $(date), solve status $solverwf" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(sed '/dumping \/fiocom/,/Error termin/d' $2 | tail -n 20 | grep -E "g_write|g_read")" ]; then
        echo "====================="; echo "Not enough disk space available. Stopping execution."; echo "====================="
        echo "Last 50 lines of the output are:"
        tail -50 $2 | sed -n '/dumping \/fiocom/{p;:a;n;/Error term/!ba};/dumping \/fiocom/!p'; echo "====================="
        diskspace $1
        echo "====================="; echo "Not enough disk space available. If it is for integrals, will now rerun."; echo "====================="
        echo "Last 50 lines of the output are:"
        tail -50 $2 | sed -n '/dumping \/fiocom/{p;:a;n;/Error term/!ba};/dumping \/fiocom/!p'; echo "====================="
        sleep 10; echo "Out of space (moving on) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "Bad file opened by")" ]; then
        echo "====================="; echo "Previous job left corrupted files, removing..."
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        rm "$1"
        > $1 # a comment will be added before the failed job in the original input file
        if [ $donlines -gt 0 ]; then
            for kdgs in $(seq $donlines)
            do
                sed -n '1,/--Link1--/Ip' $icurinfile >> $1 # a comment will be added before the failed job in the original input file
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
            done
        fi
        echo "! the next job failed, hence all below was not calculated" >> "$1"
        cat "$icurinfile" >> "$1" # done meddling with the original input file
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < "$icurinfile") -eq 0 ]; do
            sed '1 d' -i $icurinfile
        done
        echo "Restarting with name $icurinfile..."
        mauritius=$(grep -m 1 -i "%RWF=" $1)
        if [ -z "$(echo $mauritius)" ]; then
            mauricheck=$(sed -n '1,/--Link1--/Ip' $1 | grep -i '^%OldChk=')
            [ -z "$(echo $mauricheck)" ] && mauricheck=$(sed -n '1,/--Link1--/Ip' $1 | grep -i '^\s*%Chk=') || sed -i '1,/--Link1--/I{/^%OldChk=/d}' "$1"
            mauricheck=${mauricheck##*=}
            printf " RWF, INT and/or D2E files not found.\n"
            printf "Seems that the checkpoint is corrupted. Removing the checkpoint $mauricheck...\n"
            echo "Damaged checkpoint deleted for ${2%.out} on $HOSTNAME at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            [ -f "$mauricheck" ] && rm $mauricheck
        else
            mauritius=$(grep -m 3 -i -e "^%RWF=" -e "^%INT=" -e "^%D2E=" "$1" | sort -u | sed 's/.*=//;s/,[0-9]\+[MG][BW]/ /Ig')
            rm $mauritius
            ($debugging) && echo "RWF, INT and/or D2E files are mentioned in the input file..."
            echo "Garbage in $GAUSS_SCRDIR, $GAUSS_SPRSCRDIR and $HOME deleted for ${2%.out} on $HOSTNAME at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        fi
        printf " ...removed\n"; echo "====================="
        disasterindicator=$(echo "${1: -16}" | tr '3' '1' | tr '2' '1') # 3 is from geomopt solving, with adding Stable=Opt/Opt=CalcAll steps; 2 is from SC-PCM
        nosirtagad="${1%.gjf}"; nosbustagad="${nosirtagad//_fbk/}"
        if [ "$disasterindicator" == "_1_1_1_1_1_1.gjf" ] || [ $((${#nosirtagad}-${#nosbustagad})) -gt 8 ] && (! $neverstop ); then
            [ -f "${1%_1.gjf}.gjf" ] && prevroutefile=${1%_1.gjf}.gjf
            [ -f "${1%_3.gjf}.gjf" ] && prevroutefile=${1%_3.gjf}.gjf
            [ -f "${1%_2.gjf}.gjf" ] && prevroutefile=${1%_2.gjf}.gjf
            if [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "$prevroutefile")" ]; then
           # [ $(tac "$icurinfile" | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ]  <-- this I leave out now because the situation obviously cries for user intervention
                echo "Pitifully retreating solver. Proceeding with next ones..."
                icurinfile2=${1%.gjf}_$((donlines+2)).gjf
                mv "$icurinfile" "$icurinfile2"
                icurinfile="$icurinfile2"
                icuroutfile=${icurinfile%.gjf}.out
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
                until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < "$icurinfile") -eq 0 ]; do
                    sed '1 d' -i $icurinfile
                done
                echo "Restarting with name $icurinfile..."
            fi
        fi
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        [ -z "$icurinfile" ] || [ "$(wc -l < "$icurinfile")" -lt 5 ] && return 0 || return 1
    elif [ -n "$(sed '/dumping \/fiocom/,/Error termin/d' $2 | tail -n 30 | grep -E "on file out of range|NtrErr Called from FileIO")" ]; then
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        worki=$(df -h $GAUSS_SCRDIR | tail -n 1 | tr -s " " | cut -f 5 -d " " | xargs)
        [ -d "$GAUSS_SPRSCRDIR" ] && publici=$(df -h $GAUSS_SPRSCRDIR | tail -n 1 | tr -s " " | cut -f 5 -d " " | xargs) || publici=0
        worki=${worki%%%}; publici=${publici%%%}
        if [ $worki -lt 80 ] && [ $publici -lt 80 ]; then
            droppedfile=$(tail -n 300 $2 | tac | grep -m 1 'checkpoint file:' | rev | tr -d '"' | xargs | cut -d ' ' -f 1 | rev)
            echo "====================="; echo "File $droppedfile disappeared from the disk! Trying to relaunch..."; ls -l "$droppedfile"; echo "====================="
            
            disasterindicator=$(echo "${1: -16}" | tr '3' '1' | tr '2' '1') # 3 is from geomopt solving, with adding Stable=Opt/Opt=CalcAll steps; 2 is from SC-PCM
            nosirtagad="${1%.gjf}"; nosbustagad="${nosirtagad//_fbk/}"
            if [ "$disasterindicator" == "_1_1_1_1_1_1.gjf" ] || [ $((${#nosirtagad}-${#nosbustagad})) -gt 8 ] && (! $neverstop ); then
                [ -f "${1%_1.gjf}.gjf" ] && prevroutefile=${1%_1.gjf}.gjf
                [ -f "${1%_3.gjf}.gjf" ] && prevroutefile=${1%_3.gjf}.gjf
                [ -f "${1%_2.gjf}.gjf" ] && prevroutefile=${1%_2.gjf}.gjf
                if [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "$prevroutefile")" ]; then
               # [ $(tac "$icurinfile" | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ]  <-- this I leave out now because the situation obviously cries for user intervention
                    echo "Pitifully retreating solver. Proceeding with next ones..."
                    export solvegeom=0
                fi
            fi
            ( $regclean ) && getridofdirt $firstcurinfile
            echo "CHK disappeared on $HOSTNAME for ${2%.out} at $(date), solve status $solvegeom" >> $HOME/CalcLog.logg.$HOSTNAME
            generategjf $1 $2 && return 0 || return 1
        else
            echo "====================="; echo "Probably not enough disk space available (FileIO error: FNF/OoFOoR). Stopping execution."; echo "====================="
            echo "Last 30 lines of the output are:"
            tail -30 $2; echo "====================="
            diskspace $1
            ( $regclean ) && getridofdirt $firstcurinfile
            sleep 10; echo "Out of disk space on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            generategjf $1 $2 && return 0 || return 1
        fi
    elif [ -n "$(cat $2 | grep "Number of steps exceeded")" ] || { [ -n "$(ofind $2 '#' | tail -1 | grep -o ' [oO]pt[^ ]*' | grep -i 'Calc')" ] && [ -n "$(grep 'No analytic 2nd derivatives for this method' $2)" ]; }; then # cannot tail, because if thermochemistry follows, there is undeterminate space between the error message and the EOF
        if [ -n "$(tac "$1" | sed -n '1,/--Link1/p' | grep 'iterlutil anfreqevery')" ]; then
            return 0
        else
            echo "====================="; echo "Geometry optimization convergence failure (NStep exceeded). Stopping execution."; echo "====================="
            ( $regclean ) && getridofdirt $firstcurinfile
            [ $trysolve -gt 0 ] && { solvegeom=7; echo "Trying to solve the issue..."; } || solvegeom=0
    #        [ -z "$(ofind "$2" '#' | tail -1 | grep -i 'CalcAll')" ] && [ -n "$(ifind $1 '#' 2 | grep -i 'calcall')" ] && [ -z "$(grep 'No analytic 2nd derivatives for this method' $2)" ] && solvegeom=0
            echo "GeomOpt gave up on $HOSTNAME for ${2%.out} at $(date), solve status $solvegeom" >> $HOME/CalcLog.logg.$HOSTNAME
            #if [ -f "${1%_1.gjf}.gjf" ]; then
            #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvegeom=0; }
            #fi
            # [ "${2: -18}" == "_1_1_1_1_1_1_1.out" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvegeom=0; } # 3 solutions up to now
            generategjf $1 $2 && return 0 || return 1
        fi
    elif [ -n "$(tail -n 150 $2 | grep "rong number of Negative eigenvalues")" ]; then
        echo "====================="; echo "Geometry optimization convergence failure (not TS). Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        # [ $trysolve -gt 0 ] && { solvegeom=7; echo "Trying to solve the issue..."; } || solvegeom=0
        # [ -z "$(grep '#' $2 | tail -1 | grep 'CalcAll')" ] && solvegeom=0
        echo "GeomOpt(TS) gave up on $HOSTNAME for ${2%.out} at $(date), cannot solve yet :(" >> $HOME/CalcLog.logg.$HOSTNAME
        # [ "${2: -10}" == "_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvegeom=0; } # 3 solutions up to now
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "ailed to find a lower point in StbLin")" ]; then
        echo "====================="; echo "Cannot optimize the wavefunction after an instability has been found. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        for kdgs in $(seq $donlines); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        metodika=$(grep -m 1 '^#' $icurinfile | sed 's/\/.*//;s/^.* //'); goodevar=true
        [ "${metodika:0:1}" != "U" ] || goodevar=false
        if ( $goodevar ); then
            echo "Restarting with unrestrictedness and name $icurinfile..." 
            sed -i '/#/{s/'$metodika'/U'$metodika'/;:a;n;ba}' $icurinfile
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            echo "Stable=Opt gave up on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            return 1
        else
            echo "What to do? Already was unrestricted..."
            sed -i '/#/{s/Stable=Opt/SP/I;:a;n;ba}' $icurinfile
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            echo "Stable=Opt gave up on $HOSTNAME for ${2%.out} at $(date), cannot solve yet =(" >> $HOME/CalcLog.logg.$HOSTNAME
            return 1
        fi
        echo "" >> $icurinfile
    elif [ -n "$(tail -n 20 $2 | grep "no radius for atom ")" ]; then
        echo "====================="; echo "Cannot do such heavy atoms for ESP charge fitting. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        echo "Restarting with NBO and name $icurinfile..."
        for kdgs in $(seq $donlines); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        sed -i '/#/{s/MK/NPA/I;s/Dipole,AtomDipole/Minimal/I;:a;n;ba};s/,,/,/g;s/(,/(/g' $icurinfile # /#/{/SaveNBOs/s/Minimal,NBO//;:a;n;ba}
        echo "" >> $icurinfile
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        echo "An atom too heavy for ESP on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        return 1
    elif [ -n "$(tail -n 20 $2 | grep "Inaccurate quadrature in CalDSu")" ]; then
        echo "====================="; echo "Probably need for Int(Grid=UltraFine) or different ini. guess. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Inaccurate quadrature on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ $trysolve -gt 0 ] && { solveacc2=3; echo "Trying to solve the issue..."; } || solveacc2=0
        #[ "${2: -10}" == "_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvecphf=0; }
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvecphf=0; }
        #fi
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "WARNING!  Serious error in surface integrals." -e 'Surface Problems in SciFoc')" ]; then
        echo "====================="; echo "Cavity problem: the solute appears to be escaping."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Cavity problems on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ $trysolve -gt 0 ] && { solvecav=3; echo "Trying to solve the issue..."; } || solvecav=0
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvecav=0; }
        #fi
        #[ "${2: -12}" == "_1_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvecav=0; }
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "CPHF failed to converge")" ]; then
        echo "====================="; echo "CPHF not converged. Must work with tighter integral accuracy."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "CPHF diverged on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ $trysolve -gt 0 ] && { solvecphf=3; solveacc2=3; echo "Trying to solve the issue..."; } || solvecphf=0
        #[ "${2: -12}" == "_1_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvecphf=0; }
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvecphf=0; }
        #fi
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "OrtVc1 failed")" ]; then
        echo "====================="; echo "OrtVc1 failed. Must work without FMM (fast multipole method)."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "OrtVc1 failed #1 on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ $trysolve -gt 0 ] && { solvefmm=3; echo "Trying to solve the issue..."; } || solvefmm=0
        #[ "${2: -12}" == "_1_1_1_1.out" ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; solvefmm=0; }
        #if [ -f "${1%_1.gjf}.gjf" ]; then
        #    [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ] && { echo "Pitifully retreating solver. Proceeding with next ones..."; export solvefmm=0; }
        #fi
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep 'UA[^:]*: potential energy surface to get meaningful results')" ]; then
        echo "====================="; echo "Please rerun with additional spheres on hydrogens. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "UA spheres not working on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "Unable to project")" ]; then
        echo "====================="; echo "Bad initial guess. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Bad ini. guess on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "Route card not found")" ]; then
        echo "====================="; echo "Spurious '--Link1--'? Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Too much --Link1-- on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        totlines=$(grep -ce "#" $1); #((totlines--))
        donelines=$(grep -ce "Normal term" $2)
        icurinfile=${1%.gjf}_$((donelines+2)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        echo "Restarting with name $icurinfile..."
        for kdgs in $(seq $((donelines+1))); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        [ $(wc -l < $icurinfile) -lt 2 ] && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "No data on chk file" -e 'ile not found')" ]; then
        echo "====================="; echo "Cannot find CHK file with guess to be used. Restarting with the default Harris guess (Your fault if this is not what You intended)..."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        echo "Restarting with the default guess and the name $icurinfile..."
        for kdgs in $(seq $donlines); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        sed -i '1,/#/s/ Guess[=(]*Read[,]*\([^) ]*\)[)]*/ Guess=(\1)/;s/ Guess=()//' $icurinfile
        echo "Probably stray Guess=Read left on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        return 1
    elif [ -n "$(sed '/dumping \/fiocom/,/Error termin/d' $2 | tail -n 20 | grep -e 'FileIO operation on non-existent file.')" ]; then
        echo "====================="; echo "Cannot find CHK file with guess to be used. Was it deleted? Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "CHK disappeared on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "Large arrays:")" ]; then
        larga1=$(tail -n 20 $2 | grep -e "Large arrays:" | xargs)
        larga2=$(echo "$larga1" | cut -d ' ' -f 6)
        larga1=$(echo "$larga1" | cut -d ' ' -f 4)
        [ $larga2 -gt $larga1 ] && larga1=$larga2
        larga1=$((8*larga1))
        maxdsk=$(tail -n 20 $2 | grep -e "DskLim=" | xargs | cut -d ' ' -f 6)
        if [ $larga1 -gt $maxdsk ]; then
            echo "====================="; echo "Transformation cannot fit into the available disk space. Stopping execution."; echo "====================="
            echo "No space for transformation on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        else
            echo "====================="; echo "Something weird has happened. Please see output file!"; echo "====================="
            echo "Last 50 lines of it are:"
            tail -50 $2; echo "====================="
            diskspace $1    # ramsfield is implied
            echo "???? on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        fi
        ( $regclean ) && getridofdirt $firstcurinfile
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "ombination of " -e "Error translating basis functions")" ]; then
        echo "====================="; echo "Check Your structure or multiplicity! Stopping execution."; echo "====================="
        echo "Badly written .GJF (broken structure/multiplicity) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        ( $regclean ) && getridofdirt $firstcurinfile
        dos2unix $1; guglielmi=$(wc -l < $1); sed -i '/[0-9.-][0-9.-]*/{:a;N;/--Link1--/I!ba;s/\([0-9.-][0-9.-]*\)\n\n\([ ]*[A-Za-z][A-Za-z]*[ ]*[0-9.-][0-9.-]*\)/\1\n\2/}' $1
        if [ $guglielmi -gt $(wc -l < $1) ]; then
            donlines=$(grep -ce "Normal term" $2); #((totlines--))
            icurinfile=${1%.gjf}_$((donlines+1)).gjf
            cp $1 $icurinfile
            icuroutfile=${icurinfile%.gjf}.out
            echo "Restarting with name $icurinfile..."
            for kdgs in $(seq $donlines); do
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
            done
            until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
                sed '1 d' -i $icurinfile
            done
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            return 1
        else
            generategjf $1 $2 && return 0 || return 1
        fi
    elif [ -n "$(tail -n 20 $2 | grep "Must specify Eps for generic solvent\.")" ]; then
        echo "====================="; echo "The author of this input file forgot to add the Eps=, Epsinf= for their generic solvent. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Badly written .GJF (Generic solvent but no Eps=, Epsinf=) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep " could not be opened\.")" ]; then
        echo "====================="; echo "Cannot find CHK file to be used. Who prepared that .GJF?! Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Badly written .GJF (inconsistent CHKs) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "nvalid value of MaxDer in " -e "No func 3rd derivs with")" ]; then
        echo "====================="; echo "Sorry, no that high derivative for current method in Gaussian 09, rev. D.01. Stopping execution."; echo "====================="
        export remmaxder=$(tac $2 | grep -v '###' | grep -m 1 '^ #' | sed 's/^.*\( [A-Za-z0-9(),=-]*\/\).*/\1/')
        echo "Searhing to remove jobs with the following in the Route section:"; echo $remmaxder
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Method lacks requested derivatives on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "ERROR IN INITNF\. NUMBER OF VARIABLES (  0)")" ]; then
        echo "====================="; echo "Sorry, as this method uses numeric gradients, initial coordinates MUST be supplied as a Z-matrix! Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Wanted Z-matrix, found Cartesians. C'est la vie! on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "o solvent atoms in DisRep")" ]; then
        echo "====================="; echo "Sorry, no manual non-electrostatics for this solvent. Better use SMD! Stopping execution."; echo "====================="
        export remmaxder=$(tac $2 | grep -v '###' | grep -m 1 '^ #' | sed 's/^.* [Ss]olvent=\([penzamo0-9,-]*[A-Za-z0-9,-]*\)[),].*/\1/I')
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Solvent lacks DisRep on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "Only single-points with this SCRF method")" ]; then
        echo "====================="; echo "Sorry, nothing beyound single points for this solvation method. Better use SMD! Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Solvent method lacks gradients on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "Atoms too close" -e 'Problem with the distance matrix')" ]; then
        echo "====================="; echo "Something is wrong with the input structure (atoms too close)! Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "Atoms too close on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        solvescf=0; solvegeom=0
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep "Projection suppressed but bases are not identical:")" ]; then
            echo "====================="; echo "Cannot simply use the basis of previous job. Removing Guess=Read..."; echo "====================="
            ( $regclean ) && getridofdirt $firstcurinfile
            donlines=$(grep -ce "Normal term" $2); #((totlines--))
            icurinfile=${1%.gjf}_$((donlines+1)).gjf
            cp $1 $icurinfile
            icuroutfile=${icurinfile%.gjf}.out
            echo "Restarting with the explicit geometry and the name $icurinfile..."
            for kdgs in $(seq $donlines); do
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
            done
            until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
                sed '1 d' -i $icurinfile
            done
            sed -i '1,/#/{s/ Guess[=(]\+\([^ )]*\)Read\([^ )]*\)[)]*/ Guess=(\1\2)/;s/(,/(/g;s/,)/)/g;s/,,/,/g;s/ Guess=()//' $icurinfile
            echo "Probably stray Guess=Read left on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            return 1
    elif [ -n "$(tail -n 20 $2 | grep "Atom specifications unexpectedly found in input stream")" ]; then
        echo "kkk: $1"
        valiant=$(grep -c '^[\s]*#' $1); benevolent=$(grep -ci -e '--Link1--' $1); (( benevolent++ ))
        if [ $valiant -eq $benevolent ]; then
            echo "====================="; echo "Your orders are ambiguous. You give me atoms and tell not to use them. Removing Geom=Check..."; echo "====================="
            ( $regclean ) && getridofdirt $firstcurinfile
            donlines=$(grep -ce "Normal term" $2); #((totlines--))
            icurinfile=${1%.gjf}_$((donlines+1)).gjf
            cp $1 $icurinfile
            icuroutfile=${icurinfile%.gjf}.out
            echo "Restarting with the explicit geometry and the name $icurinfile..."
            for kdgs in $(seq $donlines); do
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
            done
            until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
                sed '1 d' -i $icurinfile
            done
            sed -i '1,/#/s/ Geom[=(]*Check[)]*//' $icurinfile
            echo "Probably stray Geom=Check left on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            return 1
        else
            echo "====================="; echo "--Link1-- was missing. Solving..."; echo "====================="
            ( $regclean ) && getridofdirt $firstcurinfile
            echo "Input file not perfect (no Link1 when needed) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            donlines=$(grep -ce "Normal term" $2); #((totlines--))
            icurinfile=${1%.gjf}_$((donlines+1)).gjf
            cp $1 $icurinfile
            icuroutfile=${icurinfile%.gjf}.out
            echo "Restarting with name $icurinfile..."
            for kdgs in $(seq $donlines); do
                sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
            done
            until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
                sed '1 d' -i $icurinfile
            done
            sed -i '5,/#/s/%Mem=/\\'$'\n--Link1--\\'$'\n\\'$'\n%Mem=/I' $icurinfile
            export curinfile=$icurinfile
            export curoutfile=$icuroutfile
            return 1
        fi
    elif [ -n "$(tail -n 20 $2 | grep "no atoms in this input stru")" ]; then
        echo "====================="; echo "Atoms are not there, and what am I to calculate? Assuming these are to be taken from the Checkpoint file..."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        donlines=$(grep -ce "Normal term" $2); #((totlines--))
        icurinfile=${1%.gjf}_$((donlines+1)).gjf
        cp $1 $icurinfile
        icuroutfile=${icurinfile%.gjf}.out
        echo "Restarting with the Geom=Check and the name $icurinfile..."
        for kdgs in $(seq $donlines); do
            sed '1,/--Link1--/Id' -i $icurinfile # deletes everything until first "--Link1--", including that line
        done
        until [ -n "$(head -n 1 $icurinfile | grep %)" ] || [ $(wc -l < $icurinfile) -lt 2 ]; do
            sed '1 d' -i $icurinfile
        done
        sed -i '1,/#/s/#[^!]*/& Geom=Check/' $icurinfile
        echo "Probably missing Geom=Check (no atoms found) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        export curinfile=$icurinfile
        export curoutfile=$icuroutfile
        return 1
    elif [ -f "${1%_1.gjf}.gjf" ] && [ -z "$(tail -n 5 $2 | grep "Normal termination")" ] && [ -z "$(tail -n 5 $2 | grep "Error termination")" ]; then
        # I cancelled the check because this should be better handled by generategjf
        #if [ "$(grep -m 1 '#' "$1")" == "$(grep -m 1 '#' "${1%_1.gjf}.gjf")" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -lt 2 ]; then
            echo "====================="; echo "Unhandled errors buried this job. Stopping execution."; echo "====================="
            ( $regclean ) && getridofdirt $firstcurinfile
            export solvescf=0 solvefmm=0 solvecphf=0 solveacc2=0 solvegeom=0 solverwf=0 solvecav=0 solvescpcm_redo=0 solvescpcm=0 solveimg=0
            echo "Too many consec. errors or syntax errors (case 1) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
            [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
            generategjf $1 $2 && return 0 || return 1
        #fi
    elif [ "$(uuuu=${2//_fbk/_1}; echo "${uuuu: -34}" | tr '3' '1' | tr '2' '1')" == "_1_1_1_1_1_1_1_1_1_1_1_1_1_1_1.out" ] && (! $neverstop ); then # this must work if there was some "Error termination" message
        echo "====================="; echo "Errors buried this job. Stopping execution."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        export solvescf=0 solvefmm=0 solvecphf=0 solveacc2=0 solvegeom=0 solverwf=0 solvecav=0 solvescpcm_redo=0 solvescpcm=0 solveimg=0
        echo "Too many consec. errors or syntax errors (case 2) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -n "$(tail -n 20 $2 | grep -e "Atoms in [0-9] layers were given but there should be [0-9]")" ]; then
        echo "====================="; echo "ONIOM was not defined properly! Please see output file!"; echo "====================="
        export solvescf=0 solvefmm=0 solvecphf=0 solveacc2=0 solvegeom=0 solverwf=0 solvecav=0 solvescpcm_redo=0 solvescpcm=0 solveimg=0
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "ONIOM causing tears (at sprouting) on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    elif [ -z "$(tail -n 5 $2 | grep "Normal termination")" ] && [ -z "$(tail -n 5 $2 | grep "Error termination")" ]; then
        echo "====================="; echo "Something weird has happened. Please see output file!"; echo "====================="
        echo "If You see lines similar to this:"; echo "   PGFIO/stdio: Permission denied"; echo "then You need to change scratch directory access permissions (or ask Your cluster administrator to do this)."
        echo "Last 50 lines of it are:"
        tail -50 $2; echo "====================="
        diskspace $1    # ramsfield is implied
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "??? on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    elif [ -z "$(grep "Error termination" $2)" ] && { [ -z "$(grep "imaginary frequencies (negative Signs)" $2)" ] || [ -n "$(grep -i -e 'Opt[^ ]\+QST[23]' -e 'Opt[^ ]\+TS' -e 'Opt[^ ]\+ModRedundant' $2)" ]; }; then
        echo "====================="; echo "No calculations did fail this run. Have a nice day!"; echo "====================="
        echo "All jobs done."
        echo "Calculation finish time: $(date)"
        echo "Jobs in ${2%.out} completed on $HOSTNAME at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        return 0
    elif [ -n "$(grep "imaginary frequencies (negative Signs)" $2)" ] && [ -z "$(grep -i -e 'Opt[^ ]\+QST[23]' -e 'Opt[^ ]\+TS' -e 'Opt[^ ]\+ModRedundant' $2)" ]; then
        echo "====================="; ($shsaddle) && echo "We successfully arrived at a saddle point. Congratulations! Anyway, now it will be reoptimized." || echo "We successfully arrived at a saddle point. Congratulations! Per Your choice, this WILL NOT be tackkled in any way."; echo "====================="
        ( $regclean ) && getridofdirt $firstcurinfile
        [ $trysolve -gt 0 ] && { solveimg=3; echo "Trying to solve the issue..."; } || solveimg=0
        echo "Saddle point on $HOSTNAME for ${2%.out} at $(date), solve status $solveimg" >> $HOME/CalcLog.logg.$HOSTNAME
        generategjf $1 $2 && return 0 || return 1
    else    # case not accounted for in this script
        echo "====================="; echo "Do not ask me what happened. I do not know either!"; echo "====================="
        echo "Last 50 lines of the output file are:"
        tail -50 $2; echo "====================="
        diskspace $1    # ramsfield is implied
        ( $regclean ) && getridofdirt $firstcurinfile
        echo "??!! on $HOSTNAME for ${2%.out} at $(date)" >> $HOME/CalcLog.logg.$HOSTNAME
        [ -n "$(ofind "$2" '#' | tail -1 | grep -i ' Opt')" ] && [ $(tac $2 | sed -n '1,/Entering Link 1/p' | grep -c 'Step number') -gt 1 ] && solvegeom=3
        generategjf $1 $2 && return 0 || return 1
    fi
    export solvescf=$solvescf # i think, better than loads of export this=that inside the cases
    export solvefmm=$solvefmm
    export solveacc2=$solveacc2
    export solvegeom=$solvegeom
    export solveimg=$solveimg
    export solverwf=$solverwf
    export solvecav=$solvecav
    export solvescpcm_redo=$solvescpcm_redo
    export solvescpcm=$solvescpcm
} # end of checkout()

