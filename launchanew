    b) banginghead=true ;;
    z) rmzero=false;;
    m) ramparam=true;;
    u) rmdurakov=true;;
    y) neverstop=true;;
    w) modrwf=false;;
    p) numproc=$OPTARG; [ $numproc -eq 0 ] && modproc=false;;
    k) nodalek=true;;
    l) addlinda="$OPTARG";;
    x) nomaxdisk=true;;
    I) nintersperse="$OPTARG";;
    Z) notarr=true;;
    F) nocalcall=true;;
    C) getchks="$OPTARG"; useoldchk=true;;
    v) debugging=true;;
    h) helpme=true;;
    q) whatineed=true;;
    \?) echo "Some specified options ($myopts) were not recognized by getopts. Try launchanew -h for information about available options." ;; # for cases of "invented" options
    esac
done
